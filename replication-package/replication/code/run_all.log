. 
. * Constrain coefficient one by one 
. * Start simple with just the coefficient restriction, can transform later
. 
. local i = 0

. 
. forvalues c = 0.5(0.1)1 {
  2.         
.         di "`i'"
  3.         
.         local i = `i'+1
  4.         constraint 1 rk_current_eq = `c'
  5. 
.         foreach prog in snap medicaid liheap schoolmeals ssi wic ha tanf  {  
>            
  6.                 
.                 foreach spec in "_c" "_li" {
  7. 
.                         if "`spec'" != "_c" {
  8.                                 
.                                 cnsreg rk_lifetime_eq `prog' rk_current_eq if
>  eligsim_`prog'==1 [pw=wtfam], cl(famid_orig) constraint(1)
  9.                                 store_est_tpl using constrained_reg.csv, c
> oef(`prog') name(`prog'_li_`i') all format(%6.2fc) 
 10.                                 
.                         }
 11.                         if "`spec'" == "_c" {
 12.                         
.                                 cnsreg rk_c_current_eq `prog' rk_current_eq i
> f eligsim_`prog'==1 [pw=wtfam], cl(famid_orig) constraint(1)
 13.                                 store_est_tpl using constrained_reg.csv, c
> oef(`prog') name(`prog'_c_`i') all format(%6.2fc) 
 14.                         }
 15.                         
.                 }
 16.                 
.         }
 17.         
. }
