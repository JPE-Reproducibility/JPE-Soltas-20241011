. /**************************/
. /* net and gross factors  */
. /**************************/
. foreach sheet in NetFactor NetIncomeDAMapping GrossFactor GrossIncomeDAMappin
> g DisregardUsedFor EarningsFraction DisregardFixed {
  2. import excel using "$dir/data/eligsim/tanf/raw/`sheet'.xlsx", clear
  3.   local name = lower("`sheet'")
  4. 
.     ren A state
  5. 
.     * rename variables 
.     local i = 0 
  6.     foreach var of varlist B-U {
  7.       ren `var' `name'_`=2021-`i''
  8.       local i = `i' + 1
  9.     }
 10. 
.     * reshape long   
.     drop if mi(state)
 11.     if regexm("`sheet'","DA") == 0 destring `name'_*, replace
 12.     if regexm("`sheet'","DA") == 1 tostring `name'_*, replace
 13. 
.     reshape long `name'_, i(state) j(year)
 14.     append_other_years
 15.   
.     statastates, name(state)
 16.     drop if _merge == 1
 17.     drop _merge 
 18. 
.     ren state state_name
 19.     ren state_abbrev state_postal
 20.     ren state_fips state 
 21.   
.     save "$dir/data/eligsim/tanf/`name'", replace
 22. }
