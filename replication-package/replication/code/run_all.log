> )
 27. 
.                 * Lock in deterministic row order before drawing random weigh
> ts:
.                 * (id, year) is unique in psid_int.dta, so this fixes the map
> ping
.                 * of rgamma() draws to person-year observations across machin
> es.
.                 sort id year
 28. 
.                 * Create Bayesian bootstrap weight
. 
.                 gen gamma_tmp = rgamma(0.5,0.5)
 29.                 gegen gammavar = first(gamma_tmp), by(id)
 30.                 gegen gammasum = sum(gammavar)
 31.                 replace gammavar = gammavar / gammasum
 32.                 
.                 gen wtfam_b = wtfam * gammavar
 33.                 drop gamma_tmp gammasum gammavar
 34.                 
.                 * Run Poisson reg and save FE
.                                         
.                 ppmlhdfe income_real if head==1 | spouse==1 [pw=wtfam_b], a(i
> .id#c.projection year female#married#anychild edcat#age, savefe) tol(1e-7)
 35.                                 
.                 gen fe`i' = __hdfe1__
 36.                 
