. * reliability ratio from abowd paper: 0.7 
. local abowd_factor = 0.7

. 
.         foreach prog in snap medicaid ssi ha tanf anytransfer {         
  2.     constraint 1 rk_inc = `= min(`rc_`prog''  / `abowd_factor', 1) '      
>       
  3.                 cnsreg rk_cons `prog' rk_inc if eligsim_`prog'==1 [pw=finl
> wt21], cl(cuid) constraint(1)
  4.                 store_est_tpl using constrained_reg_cex.csv, coef(`prog') 
> name(`prog'_c_preferred) all format(%6.2fc) 
  5.                 
.         }

