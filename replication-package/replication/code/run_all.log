  9.                 
.         tw      area net_effect_wic pct, fcolor(ltblue) lwidth(none) || line 
> zero mobility_effect_wic eligibility_effect_wic takeup_effect_wic pct, ///
>                 lcolor(gs3 midblue navy orange) lwidth(thin medthick medthick
>  medthick) ylab(,nogrid) ///
>                 ytitle("") xtitle("") legend(region(lwidth(none)) order(3 "Mo
> bility Effect" 4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows
> (1) size(small)) ///
>                 graphregion(lcolor(white) color(white)) yline(0, lstyle(foreg
> round)) name(wic, replace) title("WIC",color(black))
 10.                 
.         tw      area net_effect_liheap pct, fcolor(ltblue) lwidth(none) || li
> ne zero mobility_effect_liheap eligibility_effect_liheap takeup_effect_liheap
>  pct, ///
>                 lcolor(gs3 midblue navy orange) lwidth(thin medthick medthick
>  medthick) ylab(,nogrid) ///
>                 ytitle("") xtitle("") legend(region(lwidth(none)) order(3 "Mo
> bility Effect" 4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows
> (1) size(small)) ///
>                 graphregion(lcolor(white) color(white)) yline(0, lstyle(foreg
> round)) name(liheap, replace) title("LIHEAP",color(black))
 11.                 
.         if "`outcome'" == "amt" {       
 12.                 
.                 tw      area net_effect_totamt pct, fcolor(ltblue) lwidth(non
> e) || line zero mobility_effect_totamt eligibility_effect_totamt takeup_effec
> t_totamt pct, ///
>                         lcolor(gs3 midblue navy orange) lwidth(thin medthick 
> medthick medthick) ylab(,nogrid) xtitle("") ytitle("") ///
>                         legend(region(lwidth(none)) order(3 "Mobility Effect"
>  4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows(1) size(small
> )) ///
>                         graphregion(lcolor(white) color(white)) yline(0, lsty
> le(foreground)) name(tot_amt, replace) title("Cash & In-Kind",color(black))
 13. 
.                 tw      area net_effect_cashamt pct, fcolor(ltblue) lwidth(no
> ne) || line zero mobility_effect_cashamt eligibility_effect_cashamt takeup_ef
> fect_cashamt pct, ///
>                         lcolor(gs3 midblue navy orange) lwidth(thin medthick 
> medthick medthick) ylab(,nogrid)  xtitle("") ytitle("") ///
>                         legend(region(lwidth(none)) order(3 "Mobility Effect"
>  4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows(1) size(small
> )) ///
>                         graphregion(lcolor(white) color(white)) yline(0, lsty
> le(foreground)) name(cash_amt, replace) title("Cash Only",color(black))
 14.                 
.         }
 15.         
. end

