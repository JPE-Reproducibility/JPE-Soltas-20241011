.                 * Outcome
.                 cap gen equivalence_scale = ((hhsize-nchild)+0.7*nchild)^0.7

.                 cap gen eq_cons_real = consumption_real / equivalence_scale

.                 cap gen outcome = ln(eq_cons_real)

