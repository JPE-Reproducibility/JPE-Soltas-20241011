(3,746,020 real changes made)
(3,746,020 real changes made)
(3,746,020 real changes made)
(3,746,020 real changes made)
(3,746,020 real changes made)
(3,746,020 real changes made)
(3,746,020 real changes made)

.         
.         foreach eligvar in yes no {
  2.         
.     if "`eligvar'" == "no" local eligsim = "eligsim_"
  3.     if "`eligvar'" == "yes" local eligsim = "imp_elig_" 
  4. 
.         * Pooled
.         qui reghdfe rk_c_current_eq i.prog#c.bs_rk* r_ if `eligsim'==1 [pw=wt
> fam], a(prog) cl(famid_orig) 
  5.         
.         local b = _b[r_]
  6.         local se = _se[r_]
  7.         file write fh "avg,_eq,`eligvar',raw," (`b') "," (`se') _n
  8.                 
.          * Within-lifetime regression (fixed effect)
.         qui reghdfe rk_c_current_eq i.prog#c.bs_rk* r_ if `eligsim'==1 & rk_c
> urrent_eq<10  [pw=wtfam], a(prog#id) cl(famid_orig) 
  9. 
.         local b = _b[r_]
 10.         local se = _se[r_]
 11.         file write fh "avg,_eq,`eligvar',fe," (`b') "," (`se') _n
 12.         
.         }

.   
. cap file close fh

