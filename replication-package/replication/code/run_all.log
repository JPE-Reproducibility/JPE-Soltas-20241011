. 
. * Compute mobility, eligibility, takeup, and net effects
. capture program drop compute_decomp_effects

. program define compute_decomp_effects
  1. 
.         syntax, outcome(string) runvar(string)
  2.         * outcome = (amt,sh)
.         * runvar = (cons,lifetime)
. 
.         foreach p in snap medicaid ha ssi tanf schoolmeals wic liheap {
  3.         
.                 gen mobility_effect_`p' = `outcome'_`p'_cf - `outcome'_`p'_cu
> rrent
  4.                 gen eligibility_effect_`p' = `outcome'_takeup_`p'_cf - `ou
> tcome'_`p'_cf
  5.                 gen takeup_effect_`p' = `outcome'_`p'_`runvar' - `outcome'
> _takeup_`p'_cf
  6.                 gen net_effect_`p' = `outcome'_`p'_`runvar' - `outcome'_`p
> '_current
  7.                 
.         }
  8.         
.         if "`outcome'" == "amt" {
  9.                                         
.                 gen mobility_effect_totamt = tot_amt_cf - tot_amt_current
 10.                 gen eligibility_effect_totamt = tot_amt_takeup_cf - tot_am
> t_cf
 11.                 gen takeup_effect_totamt = tot_amt_`runvar' - tot_amt_take
> up_cf
 12.                 gen net_effect_totamt = tot_amt_`runvar' - tot_amt_current
 13.                 
.                 gen mobility_effect_cashamt = cash_amt_cf - cash_amt_current
 14.                 gen eligibility_effect_cashamt = cash_amt_takeup_cf - cash
> _amt_cf
 15.                 gen takeup_effect_cashamt = cash_amt_`runvar' - cash_amt_t
> akeup_cf
 16.                 gen net_effect_cashamt = cash_amt_`runvar' - cash_amt_curr
> ent
 17.                 
.         }
 18.                 
. end

. 
. cap program drop clean_decomp

. pr define clean_decomp
  1. syntax, outcome(string) runvar(string) case(string)
  2. 
.     * only permit case to be eq - that is how this is presently set up 
.     if "`case'" != "eq" {
  3.         di "case must be 'eq'"
  4.         stop 
  5.     }
  6. 
.    * Simulate eligibility               
.                 run_all_eligsims
  7.                 rename eligsim_housing_assistance eligsim_ha
  8. 
.                 * Robustness check: impute simulated eligibility for transfer
>  recipients
.                 if $imputation == 1 {
  9.                         foreach v of varlist snap medicaid liheap schoolme
> als ssi wic ha tanf {
 10.                         replace eligsim_`v' = 1 if `v' == 1
 11.                         } 
 12.                 }
 13. 
. *** EQUIVALIZED HOUSEHOLDS
.                 gen x = round(rk_current_eq*10)/10
 14.                 drop if missing(rk_c_current_eq) | missing(rk_current_eq)
 15. 
.                 foreach p in snap medicaid ha tanf ssi schoolmeals wic liheap
>  {
 16.                 
.                         gegen `outcome'_`p' = mean(`p') [aw=wtfam], by(x)
 17.                         gegen `outcome'_takeup_`p' = mean(`p') [aw=wtfam],
>  by(x eligsim_`p')
 18.                 
.                 }
 19. 
.                 drop x
 20.                 
.         * Estimate local linear regressions     
. 
.     if "`runvars'" == "cons" keep if !missing(rk_current_eq) & !missing(rk_c_
> current_eq) & !missing(rk_lifetime_eq)
 21.                 if "`runvars'" == "lifetime" keep if !missing(rk_current_e
> q) & !missing(rk_lifetime_eq) & !missing(rk_c_current_eq)
 22. 
.      gen pct = _n if _n <= 100
 23. 
. end 

. 
. * Estimate local linear regressions 
. capture program drop estimate_lpolys

. program define estimate_lpolys
  1. 
.         syntax, case(string) outcome(string) runvar(string)
  2.         * case = (eq,hh,ind)
.         * outcome = (amt,sh)
.         * runvar = (cons,lifetime)
.         
.         if "`runvar'" == "cons" {
  3.                 
.         foreach p in snap medicaid ha ssi tanf schoolmeals wic liheap {
  4.                         
.                         lpoly `outcome'_`p' rk_current_`case' [aw=wtfam], deg
> (1) bw(3) gen(`outcome'_`p'_current) at(pct) nograph
  5.                         lpoly `outcome'_`p' rk_c_current_`case' [aw=wtfam]
> , deg(1) bw(3) gen(`outcome'_`p'_cf) at(pct) nograph
  6.                         lpoly `outcome'_takeup_`p' rk_c_current_`case' [aw
> =wtfam], deg(1) bw(3) gen(`outcome'_takeup_`p'_cf) at(pct) nograph
  7.                         lpoly `p' rk_c_current_`case' [aw=wtfam], deg(1) b
> w(3) gen(`outcome'_`p'_cons) at(pct) nograph
  8.                 
.                 }
  9.         }
 10.         
.         if "`runvar'" == "lifetime" {
 11.                 
.                 foreach p in snap medicaid ha ssi tanf schoolmeals wic liheap
>  {
 12.                 
.                         lpoly `outcome'_`p' rk_current_`case' [aw=wtfam], deg
> (1) bw(3) gen(`outcome'_`p'_current) at(pct) nograph
 13.                         lpoly `outcome'_`p' rk_lifetime_`case' [aw=wtfam],
>  deg(1) bw(3) gen(`outcome'_`p'_cf) at(pct) nograph
 14.                         lpoly `outcome'_takeup_`p' rk_lifetime_`case' [aw=
> wtfam], deg(1) bw(3) gen(`outcome'_takeup_`p'_cf) at(pct) nograph
 15.                         lpoly `p' rk_lifetime_`case' [aw=wtfam], deg(1) bw
> (3) gen(`outcome'_`p'_lifetime) at(pct) nograph
 16.                                                         
.                 }
 17.         }
 18.         
.                 * Calculate total/cash amounts
.                 
.                 if "`outcome'" == "amt" {
 19.                         
.                         if "`runvar'" == "cons" {
 20.                 
.                         egen tot_amt_current = rowtotal(amt_snap_current amt_
> medicaid_current amt_ha_current amt_ssi_current amt_tanf_current amt_schoolme
> als_current amt_wic_current amt_liheap_current)
 21.                         egen tot_amt_cons = rowtotal(amt_snap_cons amt_med
> icaid_cons amt_ha_cons amt_ssi_cons amt_tanf_cons amt_schoolmeals_cons amt_wi
> c_cons amt_liheap_cons)
 22.                         egen tot_amt_cf = rowtotal(amt_snap_cf amt_medicai
> d_cf amt_ha_cf amt_ssi_cf  amt_tanf_cf amt_schoolmeals_cf amt_wic_cf amt_lihe
> ap_cf)
 23.                         egen tot_amt_takeup_cf = rowtotal(amt_takeup_snap_
> cf amt_takeup_medicaid_cf amt_takeup_ha_cf amt_takeup_ssi_cf amt_takeup_tanf_
> cf amt_takeup_schoolmeals_cf amt_takeup_wic_cf amt_takeup_liheap_cf)
 24.                         
.                         egen cash_amt_current = rowtotal(amt_snap_current amt
> _ssi_current amt_tanf_current amt_schoolmeals_current amt_liheap_current)
 25.                         egen cash_amt_cons = rowtotal(amt_snap_cons amt_ss
> i_cons amt_tanf_cons amt_schoolmeals_cons amt_liheap_cons)
 26.                         egen cash_amt_cf = rowtotal(amt_snap_cf amt_ssi_cf
>   amt_tanf_cf amt_schoolmeals_cf amt_liheap_cf)
 27.                         egen cash_amt_takeup_cf = rowtotal(amt_takeup_snap
> _cf amt_takeup_ssi_cf amt_takeup_tanf_cf amt_takeup_schoolmeals_cf amt_takeup
> _liheap_cf)
 28.                         
.                         }
 29.                         
.                         if "`runvar'" == "lifetime" {
 30.                                 
.                         egen tot_amt_current = rowtotal(amt_snap_current amt_
> medicaid_current amt_ha_current amt_ssi_current amt_tanf_current amt_schoolme
> als_current amt_wic_current amt_liheap_current)
 31.                         egen tot_amt_lifetime = rowtotal(amt_snap_lifetime
>  amt_medicaid_lifetime amt_ha_lifetime amt_ssi_lifetime amt_tanf_lifetime amt
> _schoolmeals_lifetime amt_wic_lifetime amt_liheap_lifetime)
 32.                         egen tot_amt_cf = rowtotal(amt_snap_cf amt_medicai
> d_cf amt_ha_cf amt_ssi_cf  amt_tanf_cf amt_schoolmeals_cf amt_wic_cf amt_lihe
> ap_cf)
 33.                         egen tot_amt_takeup_cf = rowtotal(amt_takeup_snap_
> cf amt_takeup_medicaid_cf amt_takeup_ha_cf amt_takeup_ssi_cf amt_takeup_tanf_
> cf amt_takeup_schoolmeals_cf amt_takeup_wic_cf amt_takeup_liheap_cf)
 34.                         
.                         egen cash_amt_current = rowtotal(amt_snap_current amt
> _ssi_current amt_tanf_current amt_schoolmeals_current amt_liheap_current)
 35.                         egen cash_amt_lifetime = rowtotal(amt_snap_lifetim
> e amt_ssi_lifetime amt_tanf_lifetime amt_schoolmeals_lifetime amt_liheap_life
> time)
 36.                         egen cash_amt_cf = rowtotal(amt_snap_cf amt_ssi_cf
>   amt_tanf_cf amt_schoolmeals_cf amt_liheap_cf)
 37.                         egen cash_amt_takeup_cf = rowtotal(amt_takeup_snap
> _cf amt_takeup_ssi_cf amt_takeup_tanf_cf amt_takeup_schoolmeals_cf amt_takeup
> _liheap_cf)
 38.                         
.                         }
 39.                 
.                 }
 40.                 
.                 * Adjust for small numerical issues in lpoly
.                 
.                 foreach p in snap medicaid ha ssi tanf schoolmeals wic liheap
>  {
 41.                         
.                         summ `outcome'_`p'_current
 42.                         local refmean = r(mean)
 43.                         
.                         summ `outcome'_`p'_cf
 44.                         local compmean = r(mean)
 45.                         replace `outcome'_`p'_cf = `outcome'_`p'_cf - `com
> pmean' + `refmean'
 46.                         
.                         summ `outcome'_takeup_`p'_cf
 47.                         local compmean = r(mean)
 48.                         replace `outcome'_takeup_`p'_cf = `outcome'_takeup
> _`p'_cf - `compmean' + `refmean'
 49.                         
.                         summ `outcome'_`p'_`runvar'
 50.                         local compmean = r(mean)
 51.                         replace `outcome'_`p'_`runvar' = `outcome'_`p'_`ru
> nvar' - `compmean' + `refmean'
 52.                                 
.                 }
 53.                 
.                 if "`outcome'" == "amt" {
 54.                         foreach p in tot_amt cash_amt {
 55.                                 
.                                 summ `p'_current
 56.                                 local refmean = r(mean)
 57.                                 
.                                 summ `p'_cf
 58.                                 local compmean = r(mean)
 59.                                 replace `p'_cf = `p'_cf - `compmean' + `re
> fmean'
 60.                                 
.                                 summ `p'_takeup_cf
 61.                                 local compmean = r(mean)
 62.                                 replace `p'_takeup_cf = `p'_takeup_cf - `c
> ompmean' + `refmean'
 63.                                 
.                                 summ `p'_`runvar'
 64.                                 local compmean = r(mean)
 65.                                 replace `p'_`runvar' = `p'_`runvar' - `com
> pmean' + `refmean'
 66.                                         
.                         }
 67.                 }
 68.                 
.         end

