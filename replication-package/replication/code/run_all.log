 18.                                         mat scat_`p'[10,2] = _b[`p']
 19.                                         mat scat_`p'[10,3] = _se[`p']
 20.                                         
.                                         summ cons_adj if single_parent==1 [aw
> =finlwt21]
 21.                                         mat scat_`p'[10,1] = r(mean)
