. /* Specification 2: additionally control for consumption rank  */
. /***************************************************************/
. cd "$dir" 
/Users/esoltas/Princeton Dropbox/Evan Soltas/Research/Completed/TransferInciden
> ce/replication

. * run regression
. foreach outcome in low_ed disabled single_parent nonwhite wage {
  2.   local digits = 3
  3.   if "`outcome'" == "wage" local digits = 1   
  4. 
.   foreach transfer in snap medicaid ha wic ssi schoolmeals tanf liheap {
  5.                         
.         reg `outcome' `transfer' bs_rk* cs_rk* if eligsim_`transfer'==1 [pw=w
> tfam], cl(famid_orig)
  6.         store_est_tpl using "tables/data/other_outcomes_c.csv", coef(`tran
> sfer') name(`outcome'_`transfer') all                 
  7.    
.   }
  8.   
.   * get mean in the bottom quintile of current income 
.   sum `outcome' if rk_current_eq < 20 [aw=wtfam] 
  9.   insert_into_file using "tables/data/other_outcomes.csv", key(`outcome'_m
> ean) value(`r(mean)') format(%5.`digits'f)
 10.   
. }
