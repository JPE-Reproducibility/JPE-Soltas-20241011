 11.         replace eligsim_schoolmeals = `age_youngest'<= 18 & `age_eldest' >
> = 5 if eligsim_schoolmeals == 1
 12.         
.         * Apply income eligibility rules
.         replace eligsim_schoolmeals = inc_to_fpl <= 185 if eligsim_schoolmeal
> s == 1
 13.         
.         * Categorical eligibility
.         replace eligsim_schoolmeals = 1 if snap == 1 | tanf == 1
 14.         
. end

. 
.                 
.                 
.                 
. 
end of do-file

. 
.  
. 
end of do-file

.         
.         set more off

.                 
.         * Compile immigrant exceptions file
. 
.         import delimited "$dir/data/eligsim/snap/immigrant_elig.csv", clear
(encoding automatically selected: UTF-8)
(16 vars, 51 obs)

.         
.         rename state_fips state

.         keep state ssi*

.         
.         save "$dir/data/eligsim/ssi_immigrant.dta", replace
file ~/Princeton Dropbox/Evan
    Soltas/Research/Completed/TransferIncidence/replication//data/eligsim/ssi
    > _immigrant.dta saved

.         
.         * SSI
.         import delimited "$dir/data/eligsim/ssi/ssi_state_supplement.csv", de
> limiter(comma) stripquote(yes) encoding(UTF-8) clear
(5 vars, 161 obs)

.         replace year = year-1
(161 real changes made)

.         
.         rename statefip state_abbrev

.         statastates, abbrev(state_abbrev)
  (all newnames==oldnames)
(0 real changes made)

    Result                      Number of obs
    -----------------------------------------
    Not matched                            28
        from master                         0  (_merge==1)
        from using                         28  (_merge==2)

    Matched                               161  (_merge==3)
    -----------------------------------------
  (all newnames==oldnames)

