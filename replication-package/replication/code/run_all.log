.         
. *** Clean up ID and time units
. 
.         gen cuid_ = substr(newid,1,length(newid)-1)

.         drop cuid

.         rename cuid_ cuid

.         
.         destring cuid newid sex_ref sex2, replace
cuid: all characters numeric; replaced as long
newid: all characters numeric; replaced as long
sex_ref: all characters numeric; replaced as byte
(11393552 missing values generated)
sex2: all characters numeric; replaced as byte
(11701303 missing values generated)

.         
.         gen yq = yq(year,qtr) 
(9,813,463 missing values generated)

.         
. *** Get age of youngest member
. 
.         gegen age_youngest = min(age), by(cuid year)

.         
. *** Get ownership of consumer durables
. 
.         gen computer_ = max(minapply == "640",mnappl1 == "640",mnappl2 == "64
> 0",mnappl3 == "640",mnappl4 == "640",mnappl5 == "640",mnappl6 == "640",mnappl
> 7 == "640",mnappl8 == "640",mnappl9 == "640")

.         replace computer_ = 1 if majcode == "13"
(365,257 real changes made)

.         gegen computer = max(computer_), by(cuid year)

.         drop computer_ majcode mnappl* minapply*

.         
. *** Pull in rental equivalents
. 
.         gegen equivrent = max(rnteqvx), by(cuid year)

.         drop rnteqvx

.         
. *** Medicaid variables --> merge into main data
. 
.         foreach v of varlist `vlist_medicaid' {
  2.                 
.                 capture destring `v', replace
  3.                 
.                 gegen tmp1 = max(`v'), by(newid year)
  4.                 gegen tmp2 = max(tmp1), by(cuid year)
  5.                 
.                 rename (tmp2 `v') (`v' tmp2)
  6.                 drop tmp1 tmp2
  7.                 
.         }

.         
. *** Run vehicle valuation module
. 
.         preserve

.                 
.         keep file newid cuid year mkmdel mkmdly make mkmodel model lsd_make m
> odelyr typeveh autotype vehicyr modelyr milesveh vehmile qadpmt1x qadpmt2x qa
> dpmt3x vehnewu

.         keep if strpos(file,"lsd")>0 | strpos(file,"ovb")>0
(10,522,401 observations deleted)

.         
.         gegen owns_new = max(vehnewu=="1"), by(cuid year)
warning: gegen is NOT parsing the expression 'vehnewu=="1"' by group.
To parse this expression by group, call gegen using the -by:- prefix.

.         gegen owns_used = max(vehnewu=="2"), by(cuid year)
warning: gegen is NOT parsing the expression 'vehnewu=="2"' by group.
To parse this expression by group, call gegen using the -by:- prefix.

.         
.         gen lease_cost = qadpmt1x + qadpmt2x + qadpmt3x
(1,453,670 missing values generated)

.         gen ln_lease_cost = ln(lease_cost)
(1,453,950 missing values generated)

.         drop qadpmt*x

.         
.         * Consolidate variables
.                 
.                 * Mileage
.                 replace milesveh = vehmile if missing(milesveh)
(500,807 real changes made)

.                 gen ln_milesveh = ln(milesveh)
(975,394 missing values generated)

.                 gen missing_miles = missing(ln_milesveh)

.                 replace ln_milesveh = -1 if missing(ln_milesveh)
(975,394 real changes made)

.                 drop vehmile

.                         
.                 * Model
.                 do "$dir/code/clean/cex/00_car_models.do"

