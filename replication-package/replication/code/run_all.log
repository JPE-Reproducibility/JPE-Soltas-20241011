. 
. * Get dollar shares (PSID)
. capture program drop get_dollar_shares

. program define get_dollar_shares
  1. 
.         cap rename housing_assistance_amt_hh ha_amt_hh
  2. 
.         * get dollar share in each program (note not equivalized bc just addi
> ng up shares) - this is in $2019 
.         foreach prog in snap wic medicaid liheap ha tanf schoolmeals ssi { 
  3.           egen total_dollars_`prog' = total(`prog'_amt_hh * wtfam  * hhsiz
> e * (year == 2019) )  
  4.           egen total_wt_`prog' = total(wtfam * hhsize * (year == 2019) )  
  5.           replace total_dollars_`prog' = total_dollars_`prog' / total_wt_`
> prog'
  6.           drop total_wt_`prog'
  7.         }
  8. 
.         * total dollars across programs 
.         egen total_dollars = rowtotal(total_dollars*) 
  9. 
.         * total dollars 
.         foreach prog in snap wic medicaid liheap ha tanf schoolmeals ssi { 
 10.           gen float weight_dollars_`prog' = total_dollars_`prog' / total_d
> ollars 
 11.           summ weight_dollars_`prog'
 12.           global wt_`prog' = r(mean)
 13.           drop weight_dollars_`prog' total_dollars_`prog'
 14.         }
 15.         drop total_dollars
 16.         
. end

. 
. * Get dollar shares (CEX)
. capture program drop get_dollar_shares_cex

. program define get_dollar_shares_cex
  1. 
.         cap rename amt_housing_assistance amt_ha
  2. 
.         * get dollar share in each program (note not equivalized bc just addi
> ng up shares) - this is in $2019
.         * No coverage of housing assistance programs in the CEX after 2013, s
> o use final value as substitute
.         foreach prog in snap medicaid ha tanf ssi { 
  3.           egen total_dollars_`prog' = total(amt_`prog' * finlwt21 * hhsize
>  * (year == 2019 | (year == 2013 & "`prog'" == "ha")) )  
  4.           egen total_wt_`prog' = total(finlwt21 * hhsize * (year == 2019  
> | (year == 2013 & "`prog'" == "ha")) )  
  5.           replace total_dollars_`prog' = total_dollars_`prog' / total_wt_`
> prog'
  6.           drop total_wt_`prog'
  7.         }
  8. 
.         * total dollars across programs 
.         egen total_dollars = rowtotal(total_dollars*) 
  9. 
.         * total dollars 
.         foreach prog in snap medicaid ha tanf ssi { 
 10.           gen float weight_dollars_`prog' = total_dollars_`prog' / total_d
> ollars 
 11.           summ weight_dollars_`prog'
 12.           global wt_`prog' = r(mean)
 13.           drop weight_dollars_`prog' total_dollars_`prog'
 14.         }
 15.         drop total_dollars
 16.         
.         rename amt_ha amt_housing_assistance 
 17.         
