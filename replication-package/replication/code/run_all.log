.         
.         drop rkgrp*

.         
.         forvalues r = 5(5)100 {
  2.                 gen rkgrp_`r' = rk_lifetime_eq >= `r'-5 & rk_lifetime_eq <
>  `r'
  3.         }

.         
.         replace rkgrp_100 = 1 if rk_lifetime_eq==100
(330 real changes made)

.                 
.         forvalues r = 5(5)100 {
  2.                 
.                 reg rkgrp_`r' snap bs_rk* if eligsim_snap==1 [pw=wtfam], cl(f
> amid_orig)
  3.                 mat coefs[`r'/5,5] = _b[snap]
  4.                 mat coefs[`r'/5,6] = _se[snap]
  5.                 
.                 reg rkgrp_`r' medicaid bs_rk* if eligsim_medicaid==1 [pw=wtfa
> m], cl(famid_orig)
  6.                 mat coefs[`r'/5,7] = _b[medicaid]
  7.                 mat coefs[`r'/5,8] = _se[medicaid]
  8.                 
.         }
