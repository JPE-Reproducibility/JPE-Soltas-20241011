> mit(0)

.                 
. * Run regressions       
. 
.         foreach p in snap medicaid ha wic liheap schoolmeals tanf {
  2.                 
.                 mat scat_`p' = J(20,3,.)
  3.                                 
.                         * By edcat
.                         forvalues k = 1/5 {
  4.                                                         
.                                 reg outcome `p' bs_rk* if eligsim_`p'==1 & ed
> cat==`k' [pw=wtfam], cl(famid_orig)
  5.                                 mat scat_`p'[`k',2] = _b[`p']
  6.                                 mat scat_`p'[`k',3] = _se[`p']
  7.                                 
.                                 summ eq_cons_real if edcat==`k' [aw=wtfam]
  8.                                 mat scat_`p'[`k',1] = r(mean)
  9. 
.                         
.                         }
 10.                         
.                         * By race/ethnicity
.                         
.                         forvalues k = 0/3 {
 11.                                                                           
>               
.                                 reg outcome `p' bs_rk* if eligsim_`p'==1 & ra
> ce_eth==`k' [pw=wtfam], cl(famid_orig)
 12.                                 mat scat_`p'[6+`k',2] = _b[`p']
 13.                                 mat scat_`p'[6+`k',3] = _se[`p']
 14.                                 
.                                 summ eq_cons_real if race_eth==`k' [aw=wtfam]
 15.                                 mat scat_`p'[6+`k',1] = r(mean)
 16. 
.                         
.                         }
 17.                         
.                         * Special concern groups
.                         
.                                 * Non-native English speakers
.                                                                 
.                                         capture gen non_native_english = lang
>  != 1 if !missing(lang)
 18.                                 
.                                         reg outcome `p' bs_rk* if eligsim_`p'
> ==1 & non_native_english==1 [pw=wtfam], cl(famid_orig)
 19.                                         mat scat_`p'[10,2] = _b[`p']
 20.                                         mat scat_`p'[10,3] = _se[`p']
 21.                                         
.                                         summ eq_cons_real if non_native_engli
> sh==1 [aw=wtfam]
 22.                                         mat scat_`p'[10,1] = r(mean)
 23.                                         
.                                 * Single parents
.                                 
.                                         capture gen nadults = hhsize - nchild
 24.                                         capture gen single_parent = nadult
> s == 1 & nchild > 0 & !missing(nchild)
 25.                                 
.                                         reg outcome `p' bs_rk* if eligsim_`p'
> ==1 & single_parent==1 [pw=wtfam], cl(famid_orig)
 26.                                         mat scat_`p'[11,2] = _b[`p']
 27.                                         mat scat_`p'[11,3] = _se[`p']
 28.                                         
.                                         summ eq_cons_real if single_parent==1
>  [aw=wtfam]
 29.                                         mat scat_`p'[11,1] = r(mean)
 30.                                         
.                                 * People with disabilities
.                                 
.                                         reg outcome `p' bs_rk* if eligsim_`p'
> ==1 & disabled==1 [pw=wtfam], cl(famid_orig)
 31.                                         mat scat_`p'[12,2] = _b[`p']
 32.                                         mat scat_`p'[12,3] = _se[`p']
 33.                                         
.                                         summ eq_cons_real if disabled==1 [aw=
> wtfam]
 34.                                         mat scat_`p'[12,1] = r(mean)
 35.                                 
.                                 * Car non-owners
.                                 
.                                         reg outcome `p' bs_rk* if eligsim_`p'
> ==1 & owncar==0 [pw=wtfam], cl(famid_orig)
 36.                                         mat scat_`p'[13,2] = _b[`p']
 37.                                         mat scat_`p'[13,3] = _se[`p']
 38.                                         
.                                         summ eq_cons_real if owncar==0 [aw=wt
> fam]
 39.                                         mat scat_`p'[13,1] = r(mean)
 40.                                         
.                         * Main estimate
.                         
.                                 reg outcome `p' bs_rk* if eligsim_`p'==1 [pw=
> wtfam], cl(famid_orig)
 41.                                 mat scat_`p'[14,2] = _b[`p']
 42.                                 
.                                 summ eq_cons_real [aw=wtfam]
 43.                                 mat scat_`p'[14,1] = r(mean)
 44.                                 
.                         
.         }
