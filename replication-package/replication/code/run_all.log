. 
.         * Amounts, receipt, and eligibility (w/o eligibility restriction)
.         foreach v of varlist tot_amt_hh snap100 eligsim_snap100 {
  2.                 forvalues i = 0/4 {
  3.                         
.                         * Values by income quintile
.                         summ `v' [aw=wtfam] if quintile_income == `i'
  4.                         local val = r(mean)
  5.                         
.                         if "`v'" == "tot_amt_hh" {
  6.                                 insert_into_file using tabulations.txt, ke
> y(`v'_`i'_avginc) value(`val') format(%12.0fc) 
  7.                         }
  8.                         if "`v'" != "tot_amt_hh" {
  9.                                 insert_into_file using tabulations.txt, ke
> y(`v'_`i'_avginc) value(`val') format(%12.1f) 
 10.                         }
 11.                         
.                         * Values by consumption quintile
.                         summ `v' [aw=wtfam] if quintile_consumption == `i'
 12.                         local val = r(mean)
 13.                         
.                         if "`v'" == "tot_amt_hh" {
 14.                                 insert_into_file using tabulations.txt, ke
> y(`v'_`i'_avgc) value(`val') format(%12.0fc) 
 15.                         }
 16.                         if "`v'" != "tot_amt_hh" {
 17.                                 insert_into_file using tabulations.txt, ke
> y(`v'_`i'_avgc) value(`val') format(%12.1f) 
 18.                         }
 19.                         
.                         * Values by lifetime quintile
.                         summ `v' [aw=wtfam] if quintile_lifetime == `i'
 20.                         local val = r(mean)
 21.                         
.                         if "`v'" == "tot_amt_hh" {
 22.                                 insert_into_file using tabulations.txt, ke
> y(`v'_`i'_avgli) value(`val') format(%12.0fc) 
 23.                         }
 24.                         if "`v'" != "tot_amt_hh" {
 25.                                 insert_into_file using tabulations.txt, ke
> y(`v'_`i'_avgli) value(`val') format(%12.1f) 
 26.                         }
 27.                 
.                         * Values by consumption quintile and income quintile
.                         forvalues j = 0/4 {
 28.                                 
.                                 summ `v' [aw=wtfam] if quintile_income == `i'
>  & quintile_consumption == `j'
 29.                                 local val = r(mean)
 30.                                 
.                                 if "`v'" == "tot_amt_hh" {
 31.                                         insert_into_file using tabulations
> .txt, key(`v'_`i'_`j') value(`val') format(%12.0fc) 
 32.                                 }
 33.                                 if "`v'" != "tot_amt_hh" {
 34.                                         insert_into_file using tabulations
> .txt, key(`v'_`i'_`j') value(`val') format(%12.1f) 
 35.                                 }
 36.                                 
.                         }
 37.                         
.                         * Values by lifetime quintile and income quintile
.                         forvalues j = 0/4 {
 38.                                 
.                                 summ `v' [aw=wtfam] if quintile_income == `i'
>  & quintile_lifetime == `j'
 39.                                 local val = r(mean)
 40.                                 
.                                 if "`v'" == "tot_amt_hh" {
 41.                                         insert_into_file using tabulations
> .txt, key(`v'_`i'_`j'l) value(`val') format(%12.0fc) 
 42.                                 }
 43.                                 if "`v'" != "tot_amt_hh" {
 44.                                         insert_into_file using tabulations
> .txt, key(`v'_`i'_`j'l) value(`val') format(%12.1f) 
 45.                                 }
 46.                                 
.                         }
 47.                 }
 48.         }

