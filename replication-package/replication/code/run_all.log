 53.         
.         ppmlhdfe income_real if head==1 | spouse==1 [pw=wtfam], a(i.age#c.tmp
> _fe_eb year female#married#anychild edcat#age, savefe) tol(1e-7) 
 54.         
.         replace projection = __hdfe1__
 55.         
.         gcollapse (mean) projection [aw=wtfam], by(age)
 56.         
.         gen r = `r'
 57.         
.         append using `projections'
