> round)) name(schoolmeals, replace) title("School Meals",color(black))
  9.                 
.         tw      area net_effect_wic pct, fcolor(ltblue) lwidth(none) || line 
> zero mobility_effect_wic eligibility_effect_wic takeup_effect_wic pct, ///
>                 lcolor(gs3 midblue navy orange) lwidth(thin medthick medthick
>  medthick) ylab(,nogrid) ///
>                 ytitle("") xtitle("") legend(region(lwidth(none)) order(3 "Mo
> bility Effect" 4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows
> (1) size(small)) ///
