. /* program store_est_tpl : store b, se, p-values in format suitable for table
> _to_tpl */
. /****************************************************************************
> *********/
. cap prog drop store_est_tpl

. prog def store_est_tpl
  1. {
  2.   syntax using/,  coef(string) name(string) [format(string) beta se p n r2
>  r2_p clust all]
  3. 
.   /* turn on all flags if `all' is specified */
.   if !mi("`all'") {
  4.     local beta beta
  5.     local se se
  6.     local p p
  7.     local n n
  8.     local r2 r2
  9.         local r2_p r2_p
 10.         local clust clust
 11.   }
 12. 
.   /* set default format if not specified */
.   if mi("`format'") local format "%6.3f"
 13. 
.   /* manage beta */
.   if !mi("`beta'") {
 14. 
.     /* store beta in the desired format */
.     local b3:  di `format' _b["`coef'"]
 15.     test `coef' = 0
 16.     local pvalue = `r(p)'
 17.     /* write p value (only makes sense if beta also specified) */
.     if !mi("`p'") {
 18.       insert_into_file using `using', key("`name'_p") value(" `pvalue'") f
> ormat("%5.2f")
 19.     }
 20. 
.     /* write beta to file */
.     insert_into_file using `using', key("`name'_beta") value(" `b3'") format(
> "`format'")
 21. 
.     /* count stars on the p and create starbeta */
.     count_stars, p(`pvalue')
 22.     insert_into_file using `using', key("`name'_starbeta") value(" `b3'`r(
> stars)'") format("`format'")
 23.   }
 24. 
.   /* manage se */
.   if !mi("`se'") {
 25.     local se3:  di `format' _se["`coef'"]
 26.     insert_into_file using `using', key("`name'_se") value(" `se3'") forma
> t("`format'")
 27.   }
 28.   
.   /* manage n */
.   if !mi("`n'") {
 29.     insert_into_file using `using', key("`name'_n") value(" `e(N)'") forma
> t("%10.0fc")
 30.   }
 31. 
.   /* manage r2 */
.   if !mi("`r2'") {
 32.     insert_into_file using `using', key("`name'_r2") value(" `e(r2)'") for
> mat("%5.3f")
 33.   }
 34.   
.   /* manage pseudo r2 */
.   if !mi("`r2_p'") {
 35.     insert_into_file using `using', key("`name'_r2_p") value(" `e(r2_p)'")
>  format("%5.3f")
 36.   }
 37.   
.   /* manage clusters */
.   if !mi("`clust'") {
 38.     insert_into_file using `using', key("`name'_clust") value(" `e(N_clust
> )'") format("%1.0f")
 39.   }
 40. }
 41. end

. /* *********** END program store_est_tpl ************************************
> ***** */
. 
