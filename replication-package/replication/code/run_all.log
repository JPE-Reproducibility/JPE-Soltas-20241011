.         di "$dir/data/cex/raw/`file'"
  3.         capture use "$dir/data/cex/raw/`file'", clear
  4.         
.         * Fix folder structure inconsistency in CEX waves
.         if _rc != 0 {
  5.                 local newfile = substr("`file'",strpos("`file'","/")+1,.)
  6.                 use "$dir/data/cex/raw/`newfile'", clear
  7.         }
  8.         
.         * Find common support of variable names
.         quietly ds
  9.         local vlist_local "`r(varlist)'"
 10.         local vlist_external "`vars'"
 11.         local vlist_common : list vlist_external & vlist_local
 12.         keep `vlist_common'
 13.         
.         * Add year and quarter variables
.         gen year = `year'
 14.         
.         * Add filename variable
.         local newfile = substr("`file'",strpos("`file'","/")+1,.)
 15.         local newfile = substr("`newfile'",strpos("`newfile'","/")+1,.)
 16.         gen file = "`newfile'"
 17.         
.         * Make sure variable types are consistent
