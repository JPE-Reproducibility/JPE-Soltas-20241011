. * Make decomposition plots
. capture program drop make_decomp_plots

. program define make_decomp_plots
  1. 
.         syntax, outcome(string)
  2.         * outcome = (amt,sh)
.         
.         capture gen zero = 0
  3. 
.         tw      area net_effect_snap pct, fcolor(ltblue) lwidth(none) || line
>  zero mobility_effect_snap eligibility_effect_snap takeup_effect_snap pct, //
> /
>                 lcolor(gs3 midblue navy orange) lwidth(thin medthick medthick
>  medthick) ylab(,nogrid) ///
>                 ytitle("") xtitle("") legend(region(lwidth(none)) order(3 "Mo
> bility Effect" 4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows
> (1) size(small)) ///
>                 graphregion(lcolor(white) color(white)) yline(0, lstyle(foreg
> round)) name(snap, replace) title("SNAP",color(black))
  4. 
.         tw      area net_effect_medicaid pct, fcolor(ltblue) lwidth(none) || 
> line zero mobility_effect_medicaid eligibility_effect_medicaid takeup_effect_
> medicaid pct, ///
>                 lcolor(gs3 midblue navy orange) lwidth(thin medthick medthick
>  medthick) ylab(,nogrid) ///
>                 ytitle("") xtitle("") legend(region(lwidth(none)) order(3 "Mo
> bility Effect" 4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows
> (1) size(small)) ///
>                 graphregion(lcolor(white) color(white)) yline(0, lstyle(foreg
> round)) name(medicaid, replace) title("Medicaid",color(black))
  5.         
.         tw      area net_effect_ha pct, fcolor(ltblue) lwidth(none) || line z
> ero mobility_effect_ha eligibility_effect_ha takeup_effect_ha pct, ///
>                 lcolor(gs3 midblue navy orange) lwidth(thin medthick medthick
>  medthick) ylab(,nogrid) ///
>                 ytitle("") xtitle("") legend(region(lwidth(none)) order(3 "Mo
> bility Effect" 4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows
> (1) size(small)) ///
>                 graphregion(lcolor(white) color(white)) yline(0, lstyle(foreg
> round)) name(ha, replace) title("Housing Assistance",color(black))
  6. 
.         tw      area net_effect_ssi pct, fcolor(ltblue) lwidth(none) || line 
> zero mobility_effect_ssi eligibility_effect_ssi takeup_effect_ssi pct, ///
>                 lcolor(gs3 midblue navy orange) lwidth(thin medthick medthick
>  medthick) ylab(,nogrid) ///
>                 ytitle("") xtitle("") legend(region(lwidth(none)) order(3 "Mo
> bility Effect" 4 "Eligibility Effect" 5 "Take-Up Effect" 1 "Net Effect") rows
> (1) size(small)) ///
>                 graphregion(lcolor(white) color(white)) yline(0, lstyle(foreg
> round)) name(ssi, replace) title("SSI",color(black))
  7.         
.         tw      area net_effect_tanf pct, fcolor(ltblue) lwidth(none) || line
