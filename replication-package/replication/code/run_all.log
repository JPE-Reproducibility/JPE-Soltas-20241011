. * Run self-targeting regression pooled across programs
. 
. foreach outcome in "_c" "_li" {
  2.         
.         preserve
  3. 
.         rename (snap medicaid liheap wic tanf ssi ha schoolmeals) (r_snap r_m
> edicaid r_liheap r_wic r_tanf r_ssi r_ha r_schoolmeals)
  4.         keep r_* id year rk_current_eq rk_c_current_eq rk_lifetime_eq wtfa
> m eligsim_* famid_orig bs_rk* cts_employment
  5.         
.         reshape long r_ eligsim_, i(id year) j(transfer) string
  6.         
.         egen prog = group(transfer)
  7. 
.         foreach prog in snap medicaid liheap schoolmeals ssi wic ha tanf {
  8.                 
.                 local wtname = "wt_`prog'"
  9.                 local wtval = ${`wtname'}
 10.                 replace wtfam = wtfam * `wtval'
 11.                 
.                 di "`prog' : `wtval'"
 12.                         
.         }
 13.         
.         * All sample
.         if "`outcome'" == "_c" {
 14.         qui reghdfe rk_c_current_eq i.prog#c.bs_rk* r_ if eligsim_==1 [pw=
> wtfam], a(prog) cl(famid_orig) 
 15.         }
 16.         if "`outcome'" == "_li" {
 17.         qui reghdfe rk_lifetime_eq i.prog#c.bs_rk* r_ if eligsim_==1 [pw=w
> tfam], a(prog) cl(famid_orig) 
 18.         }
 19.         
.         local b = _b[r_]
 20.         local se = _se[r_]
 21.         file write fh "avg,`outcome',0," (`b') "," (`se') _n
 22. 
.         * No changes in employment   
.         
.         if "`outcome'" == "_c" {
 23.         reghdfe rk_c_current_eq r_ if eligsim_==1 & cts_employment==1 [pw=
> wtfam], a(prog i.prog#c.bs_rk1 i.prog#c.bs_rk3 i.prog#c.bs_rk4 i.prog#c.bs_rk
> 5 i.prog#c.bs_rk6 i.prog#c.bs_rk7) cl(famid_orig) 
 24.         }
 25.         if "`outcome'" == "_li" {
 26.         reghdfe rk_lifetime_eq r_ if eligsim_==1 & cts_employment==1 [pw=w
> tfam], a(prog i.prog#c.bs_rk1 i.prog#c.bs_rk3 i.prog#c.bs_rk4 i.prog#c.bs_rk5
>  i.prog#c.bs_rk6 i.prog#c.bs_rk7) cl(famid_orig) 
 27.         }
 28.         
.         local b = _b[r_]
 29.         local se = _se[r_]
 30.         file write fh "avg,`outcome',1," (`b') "," (`se') _n
 31.         
.         restore
 32.         
. }
