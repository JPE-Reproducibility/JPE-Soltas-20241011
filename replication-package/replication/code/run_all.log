. /*************/
. /* DA variables  */
. /*************/
. forv hhsize = 1/12 {
  2.   
.     import excel using "$dir/data/eligsim/tanf/raw/DAX`hhsize'.xlsx", clear 
  3.     ren A state
  4. 
.     * rename variables 
.     local i = 0 
  5.     foreach var of varlist C-V {
  6.       ren `var' da_`=2021-`i''
  7.       local i = `i' + 1
  8.     }
  9.   
.     replace state = state[_n-1] if mi(state) 
 10.     drop if mi(state)
 11.     drop if mi(B)
 12.     assert da_2021 != "(Baseline)"
 13.   
.   * keep da1 and da2 and make them separate files   
.     foreach var in one two {
 14.     
.      preserve
 15.         keep if B == "`=strproper("`var'")'"
 16.         if "`var'" == "one"   ren da_* da1_*
 17.         if "`var'" == "two"   ren da_* da2_*
 18.         drop B     
 19.         tempfile da_`var'_`hhsize'
 20.         save `da_`var'_`hhsize''
 21.      restore
 22.     }  
 23. }
