  8.     file write fh "`prog',_eq,`eligvar',raw," (`b') "," (`se') _n
  9. 
.       * within-lifetime regression (fixed effect)
.        qui reghdfe rk_c_current_eq bs_rk* `prog' if `eligsim' == 1 [pw=wtfam]
> , cl(famid_orig) a(id)
 10. 
.         local b = _b[`prog']
 11.         local se = _se[`prog']
 12.         file write fh "`prog',_eq,`eligvar',fe," (`b') "," (`se') _n
 13.    
.   }
 14.   
. }

. 
. * Run self-targeting regression pooled across programs
.         
.         preserve

. 
.         rename (snap medicaid liheap wic tanf ssi ha schoolmeals) (r_snap r_m
> edicaid r_liheap r_wic r_tanf r_ssi r_ha r_schoolmeals)

.         keep r_* id year rk_current_eq rk_c_current_eq wtfam eligsim_* imp_el
> ig_* famid_orig bs_rk*

.         
.         reshape long r_ eligsim_ imp_elig_, i(id year) j(transfer) string
(j = ha housing_assistance liheap medicaid schoolmeals snap ssi tanf ui wic)
(variable eligsim_ha not found)
(variable imp_elig_ha not found)
(variable r_housing_assistance not found)
(variable r_ui not found)
(variable imp_elig_ui not found)

Data                               Wide   ->   Long
-----------------------------------------------------------------------------
Number of observations          521,124   ->   5,211,240   
Number of variables                  37   ->   16          
j variable (10 values)                    ->   transfer
xij variables:
    r_ha r_housing_assistance ... r_wic   ->   r_
eligsim_ha eligsim_housing_assistance ... eligsim_wic->eligsim_
imp_elig_ha imp_elig_housing_assistance ... imp_elig_wic->imp_elig_
-----------------------------------------------------------------------------

.         
.         egen prog = group(transfer)

. 
.         foreach prog in snap medicaid liheap schoolmeals ssi wic ha tanf {
  2.                 local wtname = "wt_`prog'"
  3.                 local wtval = ${`wtname'}
  4.                 replace wtfam = wtfam * `wtval'
  5.         }
