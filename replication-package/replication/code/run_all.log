. foreach prog in snap medicaid liheap schoolmeals ssi wic ha tanf { 
  2. 
.     * generate an imputed eligibility variable 
.     cap drop imp_elig_`prog'
  3.         gen imp_elig_`prog' = eligsim_`prog'
  4.         replace imp_elig_`prog' = 1 if `prog' == 1      
  5. 
.       * partial 
.       local threshold_low = 10
  6.       local threshold_high = 50 
  7. 
.       cap drop imp_part_`prog' 
  8.       gen imp_part_`prog' = eligsim_`prog'
  9.       replace imp_part_`prog' = 1 if rk_current_eq < `threshold_low'
 10.       
.       cap drop max_rk_current_eq 
 11.       bys id (year): egen max_rk_current_eq = max(rk_current_eq)
 12.       bys id (year): replace imp_part_`prog' = 0 if max_rk_current_eq > `t
> hreshold_high' & !mi(max_rk_current_eq) 
 13. 
. }
