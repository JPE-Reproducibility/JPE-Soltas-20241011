.                 cap drop eligsim_anytransfer

.         egen eligsim_anytransfer = rowmax(eligsim_snap eligsim_medicaid eligs
> im_liheap eligsim_schoolmeals eligsim_ssi eligsim_wic eligsim_housing eligsim
> _tanf) 

.         egen anytransfer = rowmax(snap medicaid liheap schoolmeals ssi wic ho
> using_assistance tanf)

. 
. * Predict eligibility from demographics
. 
.         keep if !missing(rk_lifetime_eq) & !missing(rk_current_eq) & !missing
> (rk_c_current_eq)
(393,809 observations deleted)

. 
.         * Generate eligibility
.         ren *housing_assistance* *ha*

.         
. * write a .csv
. cap file close fh

. file open fh using  "$dir/figures/participation_reg_robustness8.csv", write r
> eplace

. file write fh "prog,spec,alt,b,se" _n

. 
. foreach prog in anytransfer snap medicaid wic liheap schoolmeals ha ssi tanf 
> {
  2.                 
.         * All sample
.         
.                 qui reg rk_c_current_eq bs_rk* `prog' if eligsim_`prog'==1 [p
> w=wtfam], cl(famid_orig) 
  3.                 
.                 local b = _b[`prog']
  4.                 local se = _se[`prog']
  5.                 file write fh "`prog',_c,0," (`b') "," (`se') _n
  6.                         
.         * Minus B
.         
.                 capture gen equivalence_scale = ((hhsize-nchild)+0.7*nchild)^
> 0.7
  7.                 gen `prog'_amt_hh_ = `prog'_amt_hh*hhsize
  8.         
.                 * Lower consumption by transfer amount
.                 gen eq_cons_minust = (consumption_real - `prog'_amt_hh_) / eq
> uivalence_scale
  9.         
.                 bys year (eq_cons_minust): gen rk_c_current_eq_minust = sum(w
> tfam) if !missing(faminct_real) & !missing(lifetime_income) & !missing(consum
> ption_real)
 10.                 bys year: gegen min_rk_c_current_eq = min(rk_c_current_eq_
> minust)
 11.                 bys year: gegen max_rk_c_current_eq = max(rk_c_current_eq_
> minust)
 12.                 replace rk_c_current_eq_minust = 100*(rk_c_current_eq_minu
> st - min_rk_c_current_eq) / (max_rk_c_current_eq - min_rk_c_current_eq)
 13.                 
.                 drop max_rk* min_rk* eq_cons_minust
 14.           
.                 * Run regression
.                         
.                 qui reg rk_c_current_eq_minust `prog' bs_rk* if eligsim_`prog
> '==1 [pw=wtfam], cl(famid_orig) 
 15.                 
.                 local b = _b[`prog']
 16.                 local se = _se[`prog']
 17.                 file write fh "`prog',_c,1," (`b') "," (`se') _n
 18.                 drop rk_c_current_eq_minust
 19.         
.         * Plus B
.         
.                 * Raise consumption by transfer amount
.                 gen eq_cons_plust = (consumption_real + `prog'_amt_hh_) / equ
> ivalence_scale
 20.         
.                 bys year (eq_cons_plust): gen rk_c_current_eq_plust = sum(wtf
> am) if !missing(faminct_real) & !missing(lifetime_income) & !missing(consumpt
> ion_real)
 21.                 bys year: gegen min_rk_c_current_eq = min(rk_c_current_eq_
> plust)
 22.                 bys year: gegen max_rk_c_current_eq = max(rk_c_current_eq_
> plust)
 23.                 replace rk_c_current_eq_plust = 100*(rk_c_current_eq_plust
>  - min_rk_c_current_eq) / (max_rk_c_current_eq - min_rk_c_current_eq)
 24.                 
.                 drop max_rk* min_rk* equivalence_scale eq_cons_plust
 25.                 
.                 * Run regression
.                 
.                 qui reg rk_c_current_eq_plust `prog' bs_rk* if eligsim_`prog'
> ==1 [pw=wtfam], cl(famid_orig) 
 26.                 
.                 local b = _b[`prog']
 27.                 local se = _se[`prog']
 28.                 file write fh "`prog',_c,2," (`b') "," (`se') _n
 29.                 drop rk_c_current_eq_plust
 30.                 
. }
