 55.                                 
.                                 summ `p'_current
 56.                                 local refmean = r(mean)
 57.                                 
.                                 summ `p'_cf
 58.                                 local compmean = r(mean)
 59.                                 replace `p'_cf = `p'_cf - `compmean' + `re
> fmean'
 60.                                 
.                                 summ `p'_takeup_cf
 61.                                 local compmean = r(mean)
 62.                                 replace `p'_takeup_cf = `p'_takeup_cf - `c
> ompmean' + `refmean'
 63.                                 
.                                 summ `p'_`runvar'
 64.                                 local compmean = r(mean)
 65.                                 replace `p'_`runvar' = `p'_`runvar' - `com
> pmean' + `refmean'
 66.                                         
.                         }
 67.                 }
 68.                 
.         end

