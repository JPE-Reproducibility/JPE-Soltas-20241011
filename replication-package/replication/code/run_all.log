 13.                 
.     local b = _b[`prog']
 14.     local se = _se[`prog']
 15.     file write fh "`prog',`spec',`eligvar',raw," (`b') "," (`se') _n
 16. 
.       * regression if eligible
. 
.       if "`spec'" != "_c" {
 17.         qui reg rk_lifetime`spec' bs_rk* `prog' if `eligsim' == 1 [pw=wtfa
> m],  cl(famid_orig)        
 18.       }
 19.       if "`spec'" == "_c" {
 20.         qui reg rk_c_current_hh bs_rk* `prog' if `eligsim' == 1 [pw=wtfam]
> ,  cl(famid_orig)  
 21.       }
 22. 
.         local b = _b[`prog']
 23.         local se = _se[`prog']
 24.         file write fh "`prog',`spec',`eligvar',ifelig," (`b') "," (`se') _
> n
 25.       
.     }
 26.    
.   }
 27. }

