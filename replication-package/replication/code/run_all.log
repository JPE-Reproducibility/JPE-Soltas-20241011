. 
. * Run self-targeting regression pooled across programs
. 
. foreach outcome in "_c" "_li" {
  2.         
.         preserve
  3. 
.         rename (snap medicaid liheap wic tanf ssi ha schoolmeals) (r_snap r_m
> edicaid r_liheap r_wic r_tanf r_ssi r_ha r_schoolmeals)
  4.         keep r_* id year rk_current_eq rk_c_current_eq rk_lifetime_eq wtfa
> m eligsim_* famid_orig bs_rk* pr_eligsim_*
  5.         
.         reshape long r_ eligsim_ pr_eligsim_, i(id year) j(transfer) string
  6.         
.         egen prog = group(transfer)
  7. 
.         foreach prog in snap medicaid liheap schoolmeals ssi wic ha tanf {
  8.                 
.                 local wtname = "wt_`prog'"
  9.                 local wtval = ${`wtname'}
 10.                 replace wtfam = wtfam * `wtval' if transfer == "`prog'"
 11.                 
.                 di "`prog' : `wtval'"
 12.                         
.         }
 13.         
.         * All sample
.         if "`outcome'" == "_c" {
 14.         qui reghdfe rk_c_current_eq i.prog#c.bs_rk* r_ if eligsim_==1 [pw=
> wtfam], a(prog) cl(famid_orig) 
 15.         }
 16.         if "`outcome'" == "_li" {
 17.         qui reghdfe rk_lifetime_eq i.prog#c.bs_rk* r_ if eligsim_==1 [pw=w
> tfam], a(prog) cl(famid_orig) 
 18.         }
 19.         
.         local b = _b[r_]
 20.         local se = _se[r_]
 21.         file write fh "avg,`outcome',0," (`b') "," (`se') _n
 22.         
.         
.         * High eligibility sample
.                 di "`prog'"
 23.         if "`outcome'" != "_c" {
 24.                 qui reghdfe rk_lifetime_eq r_ if eligsim_==1 & pr_eligsim_
> >0.75 & !missing(pr_eligsim_`prog')  [pw=wtfam], a(prog i.prog#c.bs_rk1 i.pro
> g#c.bs_rk3 i.prog#c.bs_rk4 i.prog#c.bs_rk5 i.prog#c.bs_rk6 i.prog#c.bs_rk7) c
> l(famid_orig) 
 25.           }
 26.           if "`outcome'" == "_c" {
 27.         qui reghdfe rk_c_current_eq r_ if eligsim_==1 & pr_eligsim_>0.75 &
>  !missing(pr_eligsim_)  [pw=wtfam], a(prog i.prog#c.bs_rk1 i.prog#c.bs_rk3 i.
> prog#c.bs_rk4 i.prog#c.bs_rk5 i.prog#c.bs_rk6 i.prog#c.bs_rk7) cl(famid_orig)
>  
 28.           }
 29.         
.         local b = _b[r_]
 30.         local se = _se[r_]
 31.         file write fh "avg,`outcome',1," (`b') "," (`se') _n
 32. 
.         restore
 33.         
. }
