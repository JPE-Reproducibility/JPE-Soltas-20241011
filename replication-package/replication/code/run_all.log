. do "$dir/code/eligsim/eligsim_snap.ado"

. *** Sub-function to simulate SNAP eligibility
. 
. capture program drop eligsim_snap

. program define eligsim_snap, rclass
  1. 
. syntax, state(varname) year(varname) faminc(varname) famearn(varname) hhsize(
> varname) fpl(varname) wsav(varname) wcar(varname) yr_us(varname) qualified_im
> m(varname) citizen(varname) [ housing_exp(varname) cpi(varname) ]
  2. 
.         * Confirm program variables do not exist
.         local vlist "max_allotment std_deduction max_excess_shelter_deduction
>  inc_limit asset_limit vehexclall vehexclamt vehexclone inc_fpl excess_shelte
> r netinc netinc_fpl check_elderly* check_disabled*"
  3.         capture confirm variable eligsim_snap `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names conflicts wit
> h eligsim variables and must be renamed"
  6.                 exit 110
  7.         }
  8. 
.         * Define simulated eligibility variable
.         gen eligsim_snap = .
  9. 
.         quietly {
 10.                 
.         * Merge with eligibility data
.         merge m:1 `state' `year' `hhsize' using "$dir/data/eligsim/snap/snap"
> , keep(1 3) nogen
 11.         
.         * Calculate gross income as a share of FPL
.         gen inc_fpl = 100 * `faminc' / `fpl'
 12.         
.         local excess_shelter_thresh = 0.5
 13.         
.         * Calculate excess shelter costs
.         if "`housing_exp'" != ""  & "`cpi'" != "" {
 14.                 gen excess_shelter = min(`faminc'*max((`cpi'*`housing_exp'
> /100)/`faminc' - `excess_shelter_thresh', 0), max_excess_shelter_deduction)
 15.         }
 16.         if "`housing_exp'" == "" | "`cpi'" == "" {
 17.                 gen excess_shelter = 0 
 18.         }
 19.         
.         * Calculate net income as a share of FPL
.         gen netinc = `faminc' - std_deduction - 0.2*`famearn' - excess_shelte
> r
 20.         gen netinc_fpl = 100 * netinc / `fpl'
 21.         
.         * Apply eligibility rules
.                 
.                 * Gross income test
.                         
.                         replace eligsim_snap = 0 if inc_fpl > inc_limit & !mi
> ssing(inc_limit)
 22.                         replace eligsim_snap = 1 if inc_fpl <= inc_limit &
>  !missing(inc_limit)
 23.                         
.                 * Net income test: see https://www.cbpp.org/research/food-ass
> istance/a-quick-guide-to-snap-eligibility-and-benefits
.                 
.                         local net_inc_limit = 100
 24.                                                 
.                         replace eligsim_snap = 0 if netinc_fpl > `net_inc_lim
> it'
 25.                                                 
.                 * Asset test (ignoring vehicles)
.                 
.                         replace eligsim_snap = 0 if `wsav' > asset_limit & !m
> issing(`wsav')
 26.                         
.                 * Asset test (with vehicles)
. 
.                         replace eligsim_snap = 0 if `wsav' + max(0,`wcar'-465
> 0) > asset_limit & vehexclall == 0 & vehexclamt == 0 & vehexclone == 0 & !mis
> sing(`wcar') & !missing(`wsav')
 27.                 
.                 * Categorical eligibility
. 
.                         replace eligsim_snap = 1 if tanf == 1 | ssi == 1
 28.                         
.                 * PRWORA disqualification of immigrants
.                 
.                 merge m:1 `state' using "$dir/data/eligsim/snap_immigrant.dta
> ", nogen keep(1 3)
 29.                 
.                         * Disqualify non-qualified aliens
.                         replace eligsim_snap = 0 if `qualified_imm' == 0 & `c
> itizen' == 0
 30.                 
.                         * Disqualify if early arrival and state bans early ar
> rivals
.                         replace eligsim_snap = 0 if snap_imm_early == 0 & `yr
> _us' < 1996 & `qualified_imm' == 1  & `citizen' == 0       
 31.                 
.                         * Disqualify if late and state bans late arrivals, pr
> e 5 year wait (2002)
.                         replace eligsim_snap = 0 if snap_imm_late == 0 & (`yr
> _us' >= 1996 | missing(yr_us)) & `year' >= 1996 & `year' < 2003 & `qualified_
> imm' == 1 & `citizen' == 0    
 32.                         
.                         * Disqualify if late and state bans late arrivals, po
> st 5 year wait (2002)
.                         replace eligsim_snap = 0 if snap_imm_late == 0 & ((`y
> r_us' >= 1996 & `year' - `yr_us' < 5) | missing(yr_us)) & `year' >= 2003 & `y
> ear' < 2011 & `qualified_imm' == 1 & `citizen' == 0
 33.                         replace eligsim_snap = 0 if snap_imm_late2021 == 0
>  & ((`yr_us' >= 1996 & `year' - `yr_us' < 5)| missing(yr_us)) & `year' >= 201
> 1 & `qualified_imm' == 1 & `citizen' == 0                
 34.                                         
.         * Special eligibility rules for elderly or disabled - exempt from gro
> ss income test
.         
.                 local asset_limit_eld_dis = 4250
 35.         
.                 * Check for elderly head/spouse (60+)
.                 gen check_elderly_ = max(head,spouse)*(age>=60)
 36.                 gegen check_elderly = max(check_elderly_), by(famid year)
 37.                 replace eligsim_snap = 1 if check_elderly == 1 & netinc_fp
> l <= `net_inc_limit' & `wsav' <= max(asset_limit,`asset_limit_eld_dis')
 38.                 
.                 * Check for disabled head/spouse
.                 gen check_disabled_ = max(head,spouse)*disabled
 39.                 gegen check_disabled = max(check_disabled_), by(famid year
> )
 40.                 replace eligsim_snap = 1 if check_disabled == 1 & netinc_f
> pl <= `net_inc_limit' & `wsav' <= max(asset_limit,`asset_limit_eld_dis')
 41. 
.         * Drop variables
.         drop `vlist'
 42.         
.         }
 43.                 
. end

. 
end of do-file

. do "$dir/code/eligsim/eligsim_medicaid.ado"

. *** Sub-function to simulate Medicaid eligibility
. 
. capture program drop eligsim_medicaid

. program define eligsim_medicaid, rclass
  1. 
. syntax, state(varname) year(varname) faminc(varname) fpl(varname) age(varname
> ) age_youngest(varname) nchild(varname) eligsim_ssi(varname) disabled(varname
> ) earnings(varname) health_exp(varname) wsav(varname) yr_us(varname) married(
> varname) qualified_imm(varname) citizen(varname)
  2. 
.         * Confirm program variables do not exist
.         local vlist "inc_to_fpl fpl_pregnantwoman fpl_nondisabledadult fpl_pa
> rent has_obra86_option income_limit_single income_limit_couple income_limit_f
> pl_single income_limit_fpl_couple disregard_single disregard_couple asset_lim
> it_single asset_couple has_medicaid_buyin buyin_income_limit buyin_asset_limi
> t_single buyin_asset_limit_couple buyin_income_limit_fpl has_medically_needy_
> pathway needy_income_limit_single needy_income_limit_couple needy_asset_limit
> _single needy_asset_limit_couple"
  3.         capture confirm variable eligsim_medicaid `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names conflicts wit
> h eligsim variables and must be renamed"
  6.                 exit 110
  7.         }
  8. 
.         * Define simulated eligibility variable
.         gen eligsim_medicaid = .
  9. 
.         * Merge with eligibility data
.         merge m:1 `state' `year' using "$dir/data/eligsim/medicaid", keep(1 3
> ) nogen
 10.         
.         * Calculate income as a share of FPL
.         gen inc_to_fpl = 100 * `faminc' / `fpl'
 11.         
.         * Apply income eligibility rules
.         
.         replace eligsim_medicaid = 1 if inc_to_fpl <= fpl_nondisabledadult & 
> `nchild' == 0 & `age' >= 18 & !missing(fpl_nondisabledadult)
 12.         replace eligsim_medicaid = 1 if inc_to_fpl <= fpl_parent & `age' >
> = 18 & `nchild' > 0 & !missing(`nchild') & !missing(fpl_parent)
 13.         replace eligsim_medicaid = 1 if inc_to_fpl <= fpl_pregnantwoman & 
> `age' >= 18 & `age_youngest' == 0 & !missing(fpl_pregnantwoman)
 14.         
.         * Exclude immigrants under PRWORA
.         
.                 merge m:1 `state' using "$dir/data/eligsim/medicaid_immigrant
> .dta", nogen keep(1 3)
 15.                 
.                 * Disqualify non-qualified immigrants
.                 replace eligsim_medicaid = 0 if `qualified_imm' == 0    
 16.         
.                 * Disqualify if early arrival and state bans early arrivals
.                 replace eligsim_medicaid = 0 if medicaid_imm_early == 0 & `yr
> _us' < 1996 & `qualified_imm' == 1 & `citizen' == 0
 17.         
.                 * Disqualify if late and state bans late arrivals, pre 5 year
>  wait (2002)
.                 replace eligsim_medicaid = 0 if medicaid_imm_late == 0 & (`yr
> _us' >= 1996 | missing(yr_us)) & `year' >= 1996 & `year' < 2003 & `qualified_
> imm' == 1     & `citizen' == 0        
 18.                 
.                 * Disqualify if late and state bans late arrivals, post 5 yea
> r wait (2002)
.                 replace eligsim_medicaid = 0 if medicaid_imm_late == 0 & ((`y
> r_us' >= 1996 & `year' - `yr_us' < 5) | missing(yr_us)) & `year' >= 2003 & `y
> ear' < 2012 & `qualified_imm' == 1 & `citizen' == 0   
 19.                 replace eligsim_medicaid = 0 if medicaid_imm_late2012 == 0
>  & ((`yr_us' >= 1996 & `year' - `yr_us' < 5)| missing(yr_us)) & `year' >= 201
> 2 & `qualified_imm' == 1 & `citizen' == 0        
 20. 
.         * Other income eligibility rules (complicated)
.         
.                 * FPL pathway
.                 replace eligsim_medicaid = 1 if `disabled' == 1 & `age' >= 18
>  & `faminc' <= income_limit_single + disregard_single & `married' == 0 & !mis
> sing(income_limit_single)
 21.                 replace eligsim_medicaid = 1 if `disabled' == 1 & `age' >=
>  18 & `faminc' <= income_limit_couple + disregard_couple & `married' == 1 & !
> missing(income_limit_couple)
 22.                 replace eligsim_medicaid = 1 if `disabled' == 1 & `age' >=
>  18 & inc_to_fpl <= income_limit_fpl_single & `married' == 0 & !missing(incom
> e_limit_fpl_single)
 23.                 replace eligsim_medicaid = 1 if `disabled' == 1 & `age' >=
>  18 & inc_to_fpl <= income_limit_fpl_couple & `married' == 1 & !missing(incom
> e_limit_fpl_couple)
 24.                 
.                 * Medicaid buy-in pathway
.                 
.                 gen medicaid_buyin = 0
 25.                 replace medicaid_buyin = 1 if `disabled' == 1 & `age' >= 1
> 8 & `faminc' <= buyin_income_limit & !missing(buyin_income_limit) & `earnings
> ' > 0 & !missing(`earnings')
 26.                 replace medicaid_buyin = 1 if `disabled' == 1 & `age' >= 1
> 8 & inc_to_fpl <= buyin_income_limit_fpl & !missing(buyin_income_limit_fpl) &
>  `earnings' > 0 & !missing(`earnings')
 27.                 
.                 replace eligsim_medicaid = 1 if medicaid_buyin == 1
 28.                 
.                 * Medically needy pathway
.                 
.                 gen medically_needy = 0         
 29.                 replace medically_needy = 1 if `age' >= 18 & `faminc' - ma
> x(cpi*health_exp/100,0) <= 12*needy_income_limit_single & !missing(needy_inco
> me_limit_single) & `married' == 0
 30.                 replace medically_needy = 1 if `age' >= 18 & `faminc' - ma
> x(cpi*health_exp/100,0) <= 12*needy_income_limit_couple & !missing(needy_inco
> me_limit_couple) & `married' == 1
 31.                 
.                 replace eligsim_medicaid = 1 if medically_needy == 1
 32.         
.         
.         * Asset tests: state rules
.                 
.                 replace eligsim_medicaid = 0 if `wsav' > asset_limit_single &
>  !missing(`wsav') & !missing(asset_limit_single) & `married' == 0 & max(medic
> aid_buyin,medically_needy) == 0
 33.                 replace eligsim_medicaid = 0 if `wsav' > asset_limit_coupl
> e & !missing(`wsav') & !missing(asset_limit_couple) & `married' == 1 & max(me
> dicaid_buyin,medically_needy) == 0
 34.                 
.                 * Medicaid buy-in group
.                 
.                 replace eligsim_medicaid = 0 if `wsav' > buyin_asset_limit_si
> ngle & !missing(`wsav') & !missing(buyin_asset_limit_single) & `married' == 0
>  & medicaid_buyin == 1
 35.                 replace eligsim_medicaid = 0 if `wsav' > buyin_asset_limit
> _couple & !missing(`wsav') & !missing(buyin_asset_limit_couple) & `married' =
> = 1 & medicaid_buyin == 1
 36.                 
.                 * Medically needy group
.                 
.                 replace eligsim_medicaid = 0 if `wsav' > needy_asset_limit_si
> ngle & !missing(`wsav') & !missing(needy_asset_limit_single) & `married' == 0
>  & medically_needy == 1
 37.                 replace eligsim_medicaid = 0 if `wsav' > needy_asset_limit
> _couple & !missing(`wsav') & !missing(needy_asset_limit_couple) & `married' =
> = 1 & medically_needy == 1
 38.         
.         * Asset tests: use national rules if cannot find state rules
.         replace eligsim_medicaid = 0 if `wsav' > 2000 & !missing(`wsav') & mi
> ssing(asset_limit_single) & `married' == 0 & max(medicaid_buyin,medically_nee
> dy) == 0
 39.         replace eligsim_medicaid = 0 if `wsav' > 3000 & !missing(`wsav') &
>  missing(asset_limit_couple) & `married' == 1 & max(medicaid_buyin,medically_
> needy) == 0
 40. 
.         * Categorical eligibility via SSI eligibility
.         replace eligsim_medicaid = 1 if `eligsim_ssi' == 1 & `age' >= 18  // 
> & !inlist(state,9,15,17,27,29,33,38,40,51) [states that do not auto-grant Med
> icaid w/ SSI]
 41.         
.         * Code remaining observations as ineligible
.         replace eligsim_medicaid = 0 if missing(eligsim_medicaid)
 42.         
.         * Drop Medicaid policy variables
.         drop fpl_pregnantwoman fpl_nondisabledadult fpl_parent has_obra86_opt
> ion income_limit_single income_limit_couple income_limit_fpl_single income_li
> mit_fpl_couple disregard_single disregard_couple asset_limit_single asset_lim
> it_couple has_medicaid_buyin buyin_income_limit buyin_asset_limit_single buyi
> n_asset_limit_couple buyin_income_limit_fpl has_medically_needy_pathway needy
> _income_limit_single needy_income_limit_couple needy_asset_limit_single needy
> _asset_limit_couple inc_to_fpl
 43.         
. end

. 
.                 
.                 
.                 
. 
end of do-file

. do "$dir/code/eligsim/eligsim_liheap.ado"

. *** Sub-function to simulate LIHEAP eligibility
. 
. capture program drop eligsim_liheap

. program define eligsim_liheap, rclass
  1. 
. syntax, state(varname) year(varname) faminc(varname) hhsize(varname) wsav(var
> name) qualified_imm(varname) [ utility_exp(varname) ]
  2. 
.         * Confirm program variables do not exist
.         local vlist "heating cooling winter_crisis summer_crisis weatherizati
> on notes source smi_4_person fpg_allother fpg_alaska fpg_hawaii catelig_ssi c
> atelig_tanf catelig_snap"
  3.         capture confirm variable eligsim_liheap `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names conflicts wit
> h eligsim variables and must be renamed"
  6.                 exit 110
  7.         }
  8. 
.         * Define simulated eligibility variable
.         gen eligsim_liheap = 0
  9.         
.         * Merge with eligibility data
.         merge m:1 `state' `year' `hhsize' using "$dir/data/eligsim/liheap/lih
> eap", keep(1 3) nogen
 10.         
.         * Income test
.         
.                 * Tweaks for idiosyncratic state rules
.                 replace heating = max(heating,(55/100)*smi_4_person) if (note
> s == "all: 55 SMI if higher" | notes == "all: 55 SMI if larger")
 11.                 replace heating = (55/100)*smi_4_person if notes == "all: 
> 55 SMI if age>60 or age<2" & (age>60 | age_youngest<2)
 12.                 replace heating = max(heating,(60/100)*smi_4_person) if no
> tes == "all: 60 SMI if higher"
 13.                 replace heating = max(heating,(60/100)*smi_4_person) if no
> tes == "heating: 60 SMI if higher"
 14.                 replace heating = (150/100)*fpg_allother if (notes == "all
> : 150 if age>=60" | notes == "all: 150 FPG if age>=60") & age>=60 & !inlist(s
> tate,2,15)
 15.                 replace heating = (170/100)*fpg_allother if notes == "all:
>  170 FPG if age>60 or age<2" & (age>60 | age_youngest<2) & !inlist(state,2,15
> )
 16.                 replace heating = (150/100)*fpg_allother if notes == "heat
> ing,crisis: 150 FPG if hhsize>=7" & hhsize>=7 & !inlist(state,2,15)
 17.                 replace heating = (150/100)*fpg_allother if notes == "all:
>  150 FPG if hhsize>=7" & hhsize>=7 & !inlist(state,2,15)
 18.                 replace heating = (150/100)*fpg_allother if notes == "all:
>  150 FPG if hhsize>=8" & hhsize>=8 & !inlist(state,2,15)
 19.                 replace heating = (150/100)*fpg_allother if notes == "all:
>  150 FPG if hhsize>=10" & hhsize>=10 & !inlist(state,2,15)
 20.                 replace heating = (150/100)*fpg_allother if notes == "all:
>  150 FPG if hhsize>=11" & hhsize>=11 & !inlist(state,2,15)
 21.                 replace heating = (150/100)*fpg_allother if notes == "all:
>  150 FPG if hhsize>10" & hhsize>10 & !inlist(state,2,15)
 22.                 replace heating = (115/100)*fpg_allother if notes == "all:
>  115 FPG if hhsize>=3" & hhsize>=3 & !inlist(state,2,15)
 23.                 replace heating = (110/100)*fpg_allother if notes == "all:
>  110 FPG if hhsize>=14" & hhsize>=14 & !inlist(state,2,15)
 24.                 
.         replace eligsim_liheap = 1 if `faminc' <= heating & !missing(`faminc'
> )
 25.         
.         * Pays utilities
.         replace eligsim_liheap = 0 if `utility_exp' == 0
 26.         
.         * Asset test
.         replace eligsim_liheap = 0 if has_asset_limit == 1 & `wsav' > asset_l
> imit_amt & !missing(`wsav')
 27.         
.         * Exclude non-qualified immigrants under PRWORA
.         replace eligsim_liheap = 0 if `qualified_imm' == 0                   
>            
 28.         
.         * Categorical eligibility
.         replace eligsim_liheap = 1 if ssi == 1 & catelig_ssi == 1
 29.         replace eligsim_liheap = 1 if tanf == 1 & catelig_tanf == 1
 30.         replace eligsim_liheap = 1 if snap == 1 & catelig_snap == 1
 31.         
.         drop heating cooling winter_crisis summer_crisis weatherization notes
>  source smi_4_person fpg_allother fpg_alaska fpg_hawaii asset_limit_amt catel
> ig_*
 32.                 
. end

. 
end of do-file

. do "$dir/code/eligsim/eligsim_ui.ado"

. *** Sub-function to simulate UI eligibility
. 
. capture program drop eligsim_ui

. program define eligsim_ui, rclass
  1. 
. syntax, wks_unemp(varname) why_unemploy(varname) earnings(varname) state(varn
> ame) year(varname)
  2. 
.         * Confirm program variables do not exist
.         local vlist "eligsim_ui min_earn any_unemp"
  3.         capture confirm variable eligsim_ui `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names conflicts wit
> h eligsim variables and must be renamed"
  6.                 exit 110
  7.         }
  8. 
.         * Define simulated eligibility variable
.         gen eligsim_ui = .
  9.         
.         * Must be have been unemployed
.         gen any_unemp = `wks_unemp' > 0 if !missing(`wks_unemp')
 10.         replace eligsim_ui = any_unemp == 1
 11.         drop any_unemp
 12.         
.         * Earnings must be above threshold
.         merge m:1 `state' `year' using "$dir/data/eligsim/ui/ui_params.dta", 
> nogen keep(1 3)
 13.         replace eligsim_ui = 0 if eligsim_ui == 1 & `earnings' < min_earn/
> 1000
 14.         drop min_earn
 15.         
.         * Cannot have quit job
.         replace eligsim_ui = 0 if eligsim_ui == 1 & `why_unemploy' == 4
 16.         
.         * Ineligible if duration was too long
.         replace eligsim_ui = 0 if eligsim_ui == 1 & `wks_unemp' > max_weeks
 17.                 
.         * Must have previously worked in the covered sector
. 
. end

. 
end of do-file

. do "$dir/code/eligsim/eligsim_ssi.ado"

. *** Sub-function to simulate SSI eligibility
. 
. capture program drop eligsim_ssi

. program define eligsim_ssi, rclass
  1. 
. syntax, faminc(varname) famearn(varname) hhsize(varname) nchild(varname) wsav
> (varname) wcar(varname) disabled(varname) famid(varname) state(varname) year(
> varname) married(varname) child_disabled(varname) qualified_imm(varname) citi
> zen(varname) yr_us(varname) ssi_amt(varname) cpi(varname)
  2. 
.         * Confirm program variables do not exist
.         local vlist "sga_cutoff fbr_single fbr_couple fbr inc_ssi_calc nadult
> s_ssi countable_resources_ssi"
  3.         capture confirm variable eligsim_ssi `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names conflicts wit
> h eligsim variables and must be renamed"
  6.                 exit 110
  7.         }
  8. 
.         * Define simulated eligibility variable
.         gen eligsim_ssi = .
  9.         
.         * Must be disabled
.         gegen disabled_hh = max(`disabled'), by(`famid' `year')
 10.         replace disabled_hh = 1 if `child_disabled' == 1
 11.         replace eligsim_ssi = disabled_hh
 12.         drop disabled_hh
 13.         
.         * Income test
.         
.                 * Substantial gainful activity cutoffs by year
. 
.                 gen sga_cutoff = .
 14.                 replace sga_cutoff = 500 if `year' == 1997
 15.                 replace sga_cutoff = 700 if `year' == 1999
 16.                 replace sga_cutoff = 740 if `year' == 2001
 17.                 replace sga_cutoff = 800 if `year' == 2003
 18.                 replace sga_cutoff = 830 if `year' == 2005
 19.                 replace sga_cutoff = 900 if `year' == 2007
 20.                 replace sga_cutoff = 980 if `year' == 2009
 21.                 replace sga_cutoff = 1000 if `year' == 2011
 22.                 replace sga_cutoff = 1040 if `year' == 2013
 23.                 replace sga_cutoff = 1090 if `year' == 2015
 24.                 replace sga_cutoff = 1170 if `year' == 2017
 25.                 replace sga_cutoff = 1220 if `year' == 2019
 26. 
.                 * Federal benefit rate
. 
.                 gen fbr_single = .
 27.                 replace fbr_single = 484 if `year' == 1997
 28.                 replace fbr_single = 500 if `year' == 1999
 29.                 replace fbr_single = 531 if `year' == 2001
 30.                 replace fbr_single = 552 if `year' == 2003
 31.                 replace fbr_single = 579 if `year' == 2005
 32.                 replace fbr_single = 623 if `year' == 2007
 33.                 replace fbr_single = 674 if `year' == 2009
 34.                 replace fbr_single = 674 if `year' == 2011
 35.                 replace fbr_single = 710 if `year' == 2013
 36.                 replace fbr_single = 733 if `year' == 2015
 37.                 replace fbr_single = 735 if `year' == 2017
 38.                 replace fbr_single = 771 if `year' == 2019
 39.                 
.                 gen fbr_couple = .
 40.                 replace fbr_couple = 726 if `year' == 1997
 41.                 replace fbr_couple = 751 if `year' == 1999
 42.                 replace fbr_couple = 796 if `year' == 2001
 43.                 replace fbr_couple = 829 if `year' == 2003
 44.                 replace fbr_couple = 869 if `year' == 2005
 45.                 replace fbr_couple = 934 if `year' == 2007
 46.                 replace fbr_couple = 1011 if `year' == 2009
 47.                 replace fbr_couple = 1011 if `year' == 2011
 48.                 replace fbr_couple = 1066 if `year' == 2013
 49.                 replace fbr_couple = 1100 if `year' == 2015
 50.                 replace fbr_couple = 1103 if `year' == 2017
 51.                 replace fbr_couple = 1157 if `year' == 2019
 52.                 
.                 gen nadults_ssi = `hhsize'-`nchild'>1 if !missing(`hhsize') &
>  !missing(`nchild')
 53.                 
.                 merge m:1 `state' `year' using "$dir/data/eligsim/ssi/ssi_sta
> te_supplement.dta", nogen keep(1 3)
 54.                 
.                 replace supplement_single_indep = 0 if missing(supplement_sin
> gle_indep)
 55.                 replace supplement_couple_indep = 0 if missing(supplement_
> couple_indep)
 56.                 
.                 gen fbr = (nadults_ssi==1)*(fbr_single+supplement_single_inde
> p) + (nadults_ssi>=2 & married==1 & !missing(nadults_ssi))*(fbr_couple+supple
> ment_couple_indep)
 57.                 
.                 * Countable earnings to compare to federal benefit rate: http
> s://www.ssa.gov/ssi/text-income-ussi.htm
.                 * Note: we "undo" SSI income from family income here, b/c fam
> inc includes SSI
.                 gen ssi_amt_nom = `ssi_amt'*`cpi'
 58.                 replace ssi_amt_nom = 0 if missing(ssi_amt_nom)
 59.                 gen faminc_less_ssi = `faminc' - ssi_amt_nom
 60.                 gen inc_ssi_calc = max(0,faminc_less_ssi - 0.5*max(0,`fame
> arn'-12*65) - 12*20) if !missing(`faminc') & !missing(`famearn')
 61.                 drop faminc_less_ssi ssi_amt_nom
 62.                 
.                 * Household is ineligible if excluded by one of the income te
> sts
.                 
.                 replace eligsim_ssi = 0 if eligsim_ssi == 1 & `famearn' >= 12
> *sga_cutoff & !missing(`famearn')
 63.                 replace eligsim_ssi = 0 if eligsim_ssi == 1 & inc_ssi_calc
>  >= 12*fbr & !missing(inc_ssi_calc)
 64.                 
.                 * Exclude immigrants under PRWORA
.         
.                 merge m:1 `state' using "$dir/data/eligsim/ssi_immigrant.dta"
> , nogen keep(1 3)
 65.                 
.                         * Disqualify non-qualified aliens
.                         replace eligsim_ssi = 0 if `qualified_imm' == 0
 66.                 
.                         * Disqualify if early arrival and state bans early ar
> rivals
.                         replace eligsim_ssi = 0 if ssi_imm_early == 0 & `yr_u
> s' < 1996 & `qualified_imm' == 1 & `citizen' == 0  
 67.                 
.                         * Disqualify if late and state bans late arrivals, pr
> e 5 year wait (2002)
.                         replace eligsim_ssi = 0 if ssi_imm_late == 0 & (`yr_u
> s' >= 1996 | missing(yr_us)) & `year' >= 1996 & `year' < 2003 & `qualified_im
> m' == 1 & `citizen' == 0      
 68.                         
.                         * Disqualify if late and state bans late arrivals, po
> st 5 year wait (2002)
.                         replace eligsim_ssi = 0 if ssi_imm_late2002 == 0 & ((
> `yr_us' >= 1996 & `year' - `yr_us' < 5) | missing(yr_us)) & `year' >= 2003 & 
> `qualified_imm' == 1 & `citizen' == 0
 69.         
.         * Asset test: $3000 for couples, $2000 for singles
.                 
.                 gen countable_resources_ssi = max(0,`wsav') if `year' >= 2005
 70.                 replace countable_resources_ssi = max(0,`wsav'+max(0,`wcar
> '-4500)) if `year' < 2005
 71.                 
.                 replace eligsim_ssi = 0 if eligsim_ssi == 1 & countable_resou
> rces_ssi > 2000 & (nadults_ssi == 1 | `married'==0)
 72.                 replace eligsim_ssi = 0 if eligsim_ssi == 1 & countable_re
> sources_ssi > 3000
 73.                 
.         drop fbr fbr_single fbr_couple nadults_ssi inc_ssi_calc sga_cutoff co
> untable_resources_ssi supplement_couple_indep supplement_couple_indep
 74. 
.         replace eligsim_ssi = 0 if missing(eligsim_ssi)
 75.         
. end

. 
end of do-file

. do "$dir/code/eligsim/eligsim_wic.ado"

. *** Sub-function to simulate WIC eligibility
. 
. capture program drop eligsim_wic

. program define eligsim_wic, rclass
  1. 
. syntax, faminc(varname) fpl(varname) snap(varname) tanf(varname) medicaid(var
> name) age_youngest(varname) age_eldest(varname)
  2. 
.         * Confirm program variables do not exist
.         local vlist "eligsim_wic inc_fpl"
  3.         capture confirm variable `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names conflicts wit
> h eligsim variables and must be renamed"
  6.                 exit 110
  7.         }
  8. 
.         * Define simulated eligibility variable
.         gen eligsim_wic = 0
  9.         
.         * Categorically eligible if have child under 5
.         replace eligsim_wic = 1 if `age_youngest'<=4 | `age_eldest'<=4
 10.         
.         * Calculate gross income as a share of FPL
.         gen inc_fpl = 100 * `faminc' / `fpl'
 11.         
.         * Must satisfy one of two income eligibility rules
.         
.                 * Income eligibility test 1: must be under 185% of FPL
.                 * Income eligibility test 2: receives SNAP, TANF, or Medicaid
.                 replace eligsim_wic = 0 if eligsim_wic == 1 & inc_fpl > 185 &
>  snap == 0 & tanf == 0 & medicaid == 0
 12. 
.         drop inc_fpl    
 13.                 
. end

. 
end of do-file

. do "$dir/code/eligsim/eligsim_housing_assistance.ado"

. *** Sub-function to simulate housing assistance eligibility
. 
. capture program drop eligsim_housing_assistance

. program define eligsim_housing_assistance, rclass
  1. 
. syntax, state(varname) year(varname) faminc(varname) hhsize(varname) woth(var
> name) whome(varname) wsav(varname) famid(varname) qualified_imm(varname)
  2. 
.         * Confirm program variables do not exist
.         local vlist "ami faminc_ha qualified_imm_fam"
  3.         capture confirm variable eligsim_housing_assistance `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names conflicts wit
> h eligsim variables and must be renamed"
  6.                 exit 110
  7.         }
  8. 
.         * Define simulated eligibility variable
.         gen eligsim_housing_assistance = 1 if !missing(`faminc')
  9.                 
.         * Income test
.         merge m:1 `state' `hhsize' `year' using "$dir/data/eligsim/housing_as
> sistance/inc_limit.dta", nogen keep(1 3)
 10.         
.         gen faminc_ha = `faminc' + (`whome'+`wsav')*0.02*(`year'<2014)
 11.         
.         replace eligsim_housing_assistance = 0 if faminc_ha > ami & !missing(
> faminc_ha)
 12.         
.         drop ami faminc_ha
 13.         
.         * PRWORA immigrant exclusion
.         gegen qualified_imm_fam = max(`qualified_imm'), by(`famid' `year')
 14.         replace eligsim_housing_assistance = 0 if qualified_imm_fam == 0
 15.         drop qualified_imm_fam
 16. 
.         
. end

. 
. 
. 
end of do-file

. do "$dir/code/eligsim/eligsim_tanf.ado"

. *** Sub-function to simulate tanf eligibility
. capture program drop eligsim_tanf

. program define eligsim_tanf, rclass
  1. 
.   syntax, state(varname) year(varname) hhsize(varname) ///
>       faminc(varname) anychild(varname) wcar(varname) wsav(varname) qualified
> _imm(varname) citizen(varname) yr_us(varname) tanf_amt(varname) cpi(varname) 
> id(varname) wt(varname) 
  2.   
.         * Confirm program variables do not exist
.         local vlist "tanf_gross_elig tanf_elig _mt_*"
  3.         capture confirm variable eligsim_tanf `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names ///
  6.         conflicts with eligsim variables and must be renamed"    
  7.                 exit 110
  8.         }
  9. 
.   *** Bring in two multiplicative factors, one for gross income test and one 
> for net
.   merge m:1 `state' `year' using "$dir/data/eligsim/tanf/netfactor", keep(mas
> ter match) nogen
 10.   merge m:1 `state' `year' using "$dir/data/eligsim/tanf/grossfactor", kee
> p(master match) nogen
 11. 
.   * bring in dollar amounts 
.   merge m:1 `state' `year' `hhsize' using "$dir/data/eligsim/tanf/da_long", k
> eep(master match) nogen
 12.   
.   * get the asset variable
.   merge m:1 `state' `year' using "$dir/data/eligsim/tanf/tanf_asset", keepusi
> ng(tanf_asset) keep(master match) gen(_mt_tanfasset)
 13.   
.   * get the earnings disregard variables
.   merge m:1 `state' `year' using "$dir/data/eligsim/tanf/disregardfixed", kee
> p(master match) gen(_mt_tanfearnfixed)
 14.   ren disregardfixed tanf_earnings_fixed
 15.   
.   * get the earnings disregard _fraction_ variable  
.   merge m:1 `state' `year' using "$dir/data/eligsim/tanf/earningsfraction", k
> eep(master match) gen(_mt_tanfearnfrac)
 16.   ren earningsfraction tanf_earnings_fraction
 17.   
.   * there are some typos in the fractions, which are coded as percentages ina
> ccurately in a small number of cases 
.   replace tanf_earnings_fraction = tanf_earnings_fraction / 100 if tanf_earni
> ngs_fraction > 1 & !mi(tanf_earnings_fraction)
 18. 
.   * bring in flag that indicates which DA the net and gross income test refer
> s to
.   merge m:1 `state' `year' using "$dir/data/eligsim/tanf/netincomedamapping",
>  keep(master match) nogen
 19.   merge m:1 `state' `year' using "$dir/data/eligsim/tanf/grossincomedamapp
> ing", keep(master match) nogen
 20.   
.   * bring in flag for whether earnings disregard applies to net income test  
.   merge m:1 `state' `year' using "$dir/data/eligsim/tanf/disregardusedfor", k
> eep(master match)  nogen 
 21. 
.   * bring in the eligibility for 2002 and earlier
.   merge m:1 `state' `year' `hhsize' using "$dir/data/eligsim/tanf/tanf_need",
>  keep(master match) nogen keepusing(tanf_gross_elig)
 22. 
.   * replace the tanf income variable as being the main income less tanf
.   tempvar faminc_tanf  
 23.   gen `faminc_tanf' = `faminc' - `tanf_amt' 
 24.   
.   * assume ineligible if observed taking tanf in 3 years. include all ages fo
> r this computation, so use tanf_amt. 
.   gen nonzero_tanf = `tanf_amt' > 0 if !mi(`tanf_amt') 
 25.   bys `id' (year): gen tanf_rolling_sum = sum(nonzero_tanf)
 26.   replace tanf_rolling_sum = tanf_rolling_sum - nonzero_tanf
 27.   
.   * determine whether there is a gross income test 
.   gen uses_gross = 0 if grossincomedamapping == "None"
 28.   replace uses_gross = 1 if grossincomedamapping != "None" & !mi(grossinco
> medamapping) 
 29.   
.   * obtain net income test type 
.   gen net_map = . if netincomedamapping == "None"
 30.   replace net_map = da1 if netincomedamapping == "Use Dollar Amount #1"
 31.   replace net_map = da2 if netincomedamapping == "Use Dollar Amount #2"
 32. 
.   gen uses_net = net_map != .
 33.   
.   * for <5% of state-years after 2002, the net income test is another variabl
> e -> replace it as the modal one (da #1) 
.   replace net_map = da1 if !mi(netincomedamapping) & mi(net_map) 
 34.   
.   * earnings disregard (omit the two-parent vs. one-parent family distinction
>  in a small share of states) 
.   gen earnings_disregard_flag = 1 if inlist(disregardusedfor,"Earnings disreg
> ard used for benefit calculation and net income test","Earnings disregard use
> d only for the net income test.")
 35.   replace earnings_disregard_flag = 0 if mi(earnings_disregard_flag)
 36.   
.   *** gross income test logic:
.   *** pass the gross income test iff Gross income < DA1 * Gross income factor
.   gen pass_gross_test = ( (`faminc_tanf' / 12) <= da1 * grossfactor) if gross
> factor != 0 & uses_gross == 1 
 37.   
.   *** net income test logic:
.   *** net_DA_mapping indicates which DA the net income test refers to for a g
> iven state/year. 
.   *** If net_DA_mapping=0, no net income test, if net_DA_mapping=1, DA1, if n
> et_DA_mapping=2, DA2.
.   *** Assume the result is called "Net_Income_DA"
.   *** disregard_earnings_net_flag indicates whether the earnings disregard ap
> plies to net income test
.   
.   *** If disregard_earnings_net_flag==1, then disregard = tanf_earnings_fixed
>  + tanf_earnings_fraction * (gross_earnings - tanf_earnings_fixed)
.   *** If disregard_earnings_net_flag==0, disregard =0
.   gen disregard = tanf_earnings_fixed + tanf_earnings_fraction * (`faminc_tan
> f' - tanf_earnings_fixed) if earnings_disregard_flag == 1 
 38.   replace disregard = 0 if earnings_disregard_flag == 0
 39. 
.   *** Pass the net income test if gross_earnings - disregard < Net_Income_DA 
> * Net income factor 
.   gen pass_net_test =  (`faminc_tanf' / 12 - disregard) <= (net_map * netfact
> or) if !mi(net_map) & uses_net == 1 
 40.   
.   *** 2002 and earlier don't use the DAs 
.   gen pass_gross_test_2002 = `faminc_tanf' / 12 <= tanf_gross_elig * grossfac
> tor if !mi(tanf_gross_elig) & !mi(grossfactor) 
 41.   
.   * use gross eligibility threshold for the net test   
.   gen pass_net_test_2002 = ((`faminc_tanf' / 12) - disregard) <= tanf_gross_e
> lig * netfactor if !mi(tanf_gross_elig) & !mi(netfactor) 
 42. 
.   * if missing state, assume that they are in a state that only uses the gros
> s test and have them use the median da1
.   preserve
 43.       collapse (p50) median_da1 = da1 median_gross_elig = tanf_gross_elig 
> [aw=`wt'], by(year)
 44.       tempfile medians
 45.       save `medians'
 46.   restore
 47.   merge m:1 year using `medians', nogen   
 48.   
.   * the modal factor if used is 1.85, so that is the imputed factor for peopl
> e w/ missing state or other tanf information 
.   local imputed_gross_factor = 1.85 
 49.   gen pass_gross_test_imp = (`faminc_tanf' / 12) <= median_da1 * `imputed_
> gross_factor'
 50.   gen pass_gross_test_imp_2002 = (`faminc_tanf' / 12) <= median_gross_elig
>  * `imputed_gross_factor'
 51.   
.         * Asset test
.   
.   * only count as being above the asset threshold if positive evidence of bei
> ng above
.   * assume vehicles are fully exempt -> note there are 9 millions, these will
>  never bind 
.   gen above_asset = max(0,`wsav') > tanf_asset if !mi(tanf_asset) 
 52.   
.   /***************************************/
.   /* * construct eligibility simulation  */
.   /***************************************/
.   * must pass a gross test, or a net test
.   * and then have a child, and pass the asset test, and not have been present
>  for 6 years on the program 
.   
.   * main: after 2002 
.   gen eligsim_tanf = (pass_gross_test == 1 | uses_gross == 0) & (pass_net_tes
> t == 1 | uses_net == 0 ) & `anychild' == 1 & (above_asset == 0) & tanf_rollin
> g_sum <= 2 if year > 2002
 53. 
.   * 2002 and earlier have different eligibility thresholds
.   replace eligsim_tanf = (pass_gross_test_2002 == 1 | uses_gross == 0) & (pas
> s_net_test_2002 == 1 | uses_net == 0 ) & `anychild' == 1 & (above_asset == 0)
>  & tanf_rolling_sum <= 2 if year <= 2002 
 54. 
.   * if you do not observe EITHER a net OR a gross test (e.g., missing state) 
> then assume they are like the median state
.   replace eligsim_tanf = pass_gross_test_imp == 1  & `anychild' == 1 & (above
> _asset == 0) & tanf_rolling_sum <= 2 if year > 2002 & uses_net != 1 & uses_gr
> oss != 1
 55.   replace eligsim_tanf = pass_gross_test_imp_2002 == 1 & `anychild' == 1 &
>  (above_asset == 0) & tanf_rolling_sum <= 2 if year <= 2002 & uses_net != 1 &
>  uses_gross != 1
 56. 
. 
.   drop _mt_*
 57.   
.   * Exclude immigrants under PRWORA
.         merge m:1 `state' using "$dir/data/eligsim/tanf_immigrant.dta", nogen
>  keep(1 3)
 58.         
.   * Disqualify non-qualified aliens
.   replace eligsim_tanf = 0 if `qualified_imm' == 1 & `citizen' == 0
 59. 
.   * Disqualify if early arrival and state bans early arrivals
.   replace eligsim_tanf = 0 if tanf_imm_early == 0 & `yr_us' < 1996 & `qualifi
> ed_imm' == 1        & `citizen' == 0
 60. 
.   * Disqualify if late and state bans late arrivals, pre 5 year wait (2002)
.   replace eligsim_tanf = 0 if tanf_imm_late == 0 & (`yr_us' >= 1996 | missing
> (yr_us)) & `year' >= 1996 & `year' < 2003 & `qualified_imm' == 1 & `citizen' 
> == 0  
 61. 
.   * Disqualify if late and state bans late arrivals, post 5 year wait (2002)
.   replace eligsim_tanf = 0 if tanf_imm_late2011 == 0 & ((`yr_us' >= 1996 & `y
> ear' - `yr_us' < 5) | missing(yr_us)) & `year' >= 2003 & `year' < 2011 & `qua
> lified_imm' == 1 & `citizen' == 0             
 62.   replace eligsim_tanf = 0 if tanf_imm_late2011 == 0 & ((`yr_us' >= 1996 &
>  `year' - `yr_us' < 5) | missing(yr_us)) & `year' >= 2003 & `year' >= 2011 & 
> `qualified_imm' == 1 & `citizen' == 0            
 63. 
. end

. 
end of do-file

. do "$dir/code/eligsim/eligsim_schoolmeals.ado"

. *** Sub-function to simulate NSLP eligibility
. 
. capture program drop eligsim_schoolmeals

. program define eligsim_schoolmeals, rclass
  1. 
. syntax, state(varname) year(varname) faminc(varname) fpl(varname) age_eldest(
> varname) age_youngest(varname) anychild(varname)
  2. 
.         * Confirm program variables do not exist
.         local vlist ""
  3.         capture confirm variable eligsim_schoolmeals `vlist'
  4. 
.         if !_rc {
  5.                 display as error "One of your variable names conflicts wit
> h eligsim variables and must be renamed"
  6.                 exit 110
  7.         }
  8. 
.         * Define simulated eligibility variable
.         gen eligsim_schoolmeals = .
  9.         
.         * Calculate income as a share of FPL
.         capture gen inc_to_fpl = 100 * `faminc' / `fpl'
 10.         
.         * Require school-age child
.         replace eligsim_schoolmeals = anychild
 11.         replace eligsim_schoolmeals = `age_youngest'<= 18 & `age_eldest' >
> = 5 if eligsim_schoolmeals == 1
 12.         
.         * Apply income eligibility rules
.         replace eligsim_schoolmeals = inc_to_fpl <= 185 if eligsim_schoolmeal
> s == 1
 13.         
.         * Categorical eligibility
.         replace eligsim_schoolmeals = 1 if snap == 1 | tanf == 1
 14.         
. end

. 
.                 
.                 
.                 
. 
end of do-file

. 
.  
. 
end of do-file

