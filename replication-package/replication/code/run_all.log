. /****************/
. /* Three version  */
. /****************/
. 
. * generate a graph that is all programs together
. local avgname {bf:Average}

. local wicname WIC

. local snapname SNAP

. local schoolmealsname "School Meals"

. local ssiname SSI

. local tanfname TANF

. local medicaidname Medicaid

. local liheapname LIHEAP

. local haname Housing

. 
. foreach imputed in "yes" "no" { 
  2.   foreach spec in  "_eq" "_c" {
  3.     
.     import delimited using  "$dir/figures/participation_reg.csv", clear
  4.     keep if spec == "`spec'" & imputed == "`imputed'"
  5.         drop if prog == "avg_of_5"
  6.     gen high = b + 1.96 * se
  7.     gen low = b - 1.96 * se
  8. 
.     * sorting 
.     gen raweffect_tmp = b if regtype == "raw"
  9.     bys prog: egen raweffect = mean(raweffect_tmp)
 10.     replace raweffect = 5 if prog == "avg" 
 11. 
. 
.     gen order = 1 if regtype == "raw" 
 12.     replace order = 2 if regtype == "ifelig" 
 13.     replace order = 3 if regtype == "richcontrols"
 14.     replace order = 4 if regtype == "unusedobservables"    
 15. 
.     gsort raweffect -order
 16.     
.     gen index = 1
 17.     replace index = 0 if regtype == "unusedobservables" 
 18.     gen n = sum(index)
 19.     gen n_of_raw_tmp = n if regtype == "raw" 
 20.     bys prog: egen n_of_raw = total(n_of_raw_tmp)
 21.     replace n = n_of_raw if regtype == "unusedobservables"
 22. 
.     gsort raweffect -order
 23.     
.     gen index_me = 1
 24.     replace index_me = 0 if regtype == "raw" 
 25.     gen n_me = sum(index_me)
 26.     gen n_of_uo_tmp = n_me if regtype == "unusedobservables" 
 27.     bys prog: egen n_of_uo = total(n_of_uo_tmp)
 28.     replace n_me = n_of_uo if regtype == "raw"
 29. 
.     gsort raweffect -order
 30.     
.     * rerank with and without unused observables 
.     preserve
 31.         drop if regtype == "unusedobservables"    
 32.         local ylabel = ""
 33.         foreach obs of numlist 2(3)`=_N-1' {
 34.           local progtype = prog[`obs']
 35.           local name ``progtype'name'
 36.           local ylabel = `" `ylabel' `obs' "`name'" "'
 37.         }
 38.     restore
 39. 
.     preserve
 40.         drop if regtype == "raw"        
 41.         local ylabel_me = ""
 42.         foreach obs of numlist 2(3)`=_N-1' {
 43.           local progtype = prog[`obs']
 44.           local name ``progtype'name'
 45.           local ylabel_me = `" `ylabel' `obs' "`name'" "'
 46.         }    
 47.     restore
 48.     
.     global navy `" "51 122 183" "'
 49.     global green `" "92 184 92" "'
 50.     global ltblue `" "91 192 222" "'
 51.     global red `" "217 83 79" "'
 52.     global orange `" "240 173 78" "'
 53.     
.     if "`spec'" != "_c" {
 54. 
.     gr twoway /// 
>         (rcap high low n if regtype == "raw", color($navy) msize(medium) hori
> zontal xline(0,lcolor(gs9)) xlabel(-20(5)5) xscale(range(-20 5))) ///
>         (rcap high low n if regtype == "ifelig", msize(medium)  color($orange
> ) horizontal ) ///
>       (rcap high low n if regtype == "richcontrols", msize(medium)  color($lt
> blue) horizontal  ///
>       yline(3.5(3)`=_N+3.5', lcolor(gray) lpattern(dash) ) ) /// 
>       (scatter n b if regtype == "raw", msymbol(O) msize(medium) color($navy)
>  ylabel(`ylabel') ///
