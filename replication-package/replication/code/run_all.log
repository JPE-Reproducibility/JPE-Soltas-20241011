.         
.         * Receipt conditional on eligibility
.         forvalues i = 0/4 {
  2.                 
.                 * Values by income quintile
.                 summ snap100 [aw=wtfam] if quintile_income == `i' & eligsim_s
> nap == 1
  3.                 local val = r(mean)
  4.                 
.                 insert_into_file using tabulations.txt, key(snapifelig_`i'_av
> ginc) value(`val') format(%12.1f) 
  5.                 
.                 * Values by consumption quintile
.                 summ snap100 [aw=wtfam] if quintile_consumption == `i' & elig
> sim_snap == 1
  6.                 local val = r(mean)
  7.                 
.                 insert_into_file using tabulations.txt, key(snapifelig_`i'_av
> gc) value(`val') format(%12.1f) 
  8.                 
.                 * Values by lifetime quintile
.                 summ snap100 [aw=wtfam] if quintile_lifetime == `i' & eligsim
> _snap == 1
  9.                 local val = r(mean)
 10.                 
.                 insert_into_file using tabulations.txt, key(snapifelig_`i'_av
> gli) value(`val') format(%12.1f) 
 11.         
.                 * Values by consumption quintile and income quintile
.                 forvalues j = 0/4 {
 12.                         
.                         summ snap100 [aw=wtfam] if quintile_income == `i' & q
> uintile_consumption == `j' & eligsim_snap == 1
 13.                         local val = r(mean)
 14.                         
.                         insert_into_file using tabulations.txt, key(snapifeli
> g_`i'_`j') value(`val') format(%12.1f) 
 15.                         
.                 }
 16.                 
.                 * Values by lifetime income quintile and income quintile
.                 forvalues j = 0/4 {
 17.                         
.                         summ snap100 [aw=wtfam] if quintile_income == `i' & q
> uintile_lifetime == `j' & eligsim_snap == 1
 18.                         local val = r(mean)
 19.                         
.                         insert_into_file using tabulations.txt, key(snapifeli
> g_`i'_`j'l) value(`val') format(%12.1f) 
 20.                         
.                 }
 21.         }

